@using PetalStory.Models

@{
    ViewData["Title"] = "Оформление заказа";

    var addresses =
        ViewBag.Addresses as List<UserAddress>
        ?? new();

    decimal total =
        ViewBag.Total ?? 0;
}

<div class="container py-5">

    <h1 class="mb-4">
        Оформление заказа
    </h1>

    <div class="checkout-card">

        <h5 class="mb-3">
            Адрес доставки
        </h5>
        <div class="addresses-container">
        @if (addresses.Any())
        {
            @foreach (var address in addresses)
            {
                <label class="address-card">

                    <input type="radio"
                           name="addressId"
                           value="@address.Id"
                           @(address.IsDefault ? "checked" : "") />

                    <span>

                        <strong>
                            @address.Address
                        </strong>

                        <br>

                        <span class="text-muted small">

                            @address.RecipientName

                            @if (!string.IsNullOrEmpty(address.Phone))
                            {
                                <span>
                                    • @address.Phone
                                </span>
                            }

                        </span>

                    </span>

                </label>
            }
        }
            <label class="address-card">

                <input type="radio"
                       name="addressId"
                       value="0" />

                <span>

                    <strong>
                        Новый адрес
                    </strong>

                    <br>

                    <span class="text-muted small">
                        Ввести другой адрес доставки
                    </span>

                </span>

            </label>
        </div>

        <div id="newAddressBlock"
             style="display:none;">

            <hr />

            <h5 class="mb-3">
                Новый адрес
            </h5>

            <input id="recipientName"
                   class="form-control mb-3"
                   placeholder="Получатель" />

            <input id="recipientPhone"
                   class="form-control mb-3"
                   placeholder="Телефон"
                   maxlength="12" />

            <input id="newAddress"
                   class="form-control mb-3"
                   placeholder="Адрес доставки" />

            <div class="form-check mb-4">

                <input class="form-check-input"
                       type="checkbox"
                       id="saveAddress" />

                <label class="form-check-label">

                    Сохранить адрес

                </label>

            </div>

        </div>

        <h5 class="mb-3">
            Комментарий
        </h5>

        <textarea id="comment"
                  class="form-control mb-4"
                  rows="4"></textarea>

        <div class="checkout-total">

            Итого:
            @total.ToString("N0") ₽

        </div>

        <button id="openPaymentModal"
                class="btn btn-success mt-4">

            Перейти к оплате

        </button>

    </div>
    <div class="modal fade"
         id="paymentModal"
         tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Способ оплаты
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <div class="form-check mb-3">

                        <input class="form-check-input"
                               type="radio"
                               name="paymentMethod"
                               id="cardPayment"
                               value="paymentCard"
                               checked>

                        <label class="form-check-label"
                               for="cardPayment">

                            Банковская карта

                        </label>

                    </div>

                    <div class="form-check">

                        <input class="form-check-input"
                               type="radio"
                               name="paymentMethod"
                               id="sbpPayment"
                               value="paymentSBP">

                        <label class="form-check-label"
                               for="sbpPayment">

                            СБП

                        </label>

                    </div>

                    <div class="fw-bold fs-5">

                        К оплате:
                        @total.ToString("N0") ₽

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Отмена

                    </button>

                    <button type="button"
                            id="createOrderBtn"
                            class="btn btn-success">

                        Оплатить

                    </button>

                </div>

            </div>

        </div>

    </div>
</div>
<style>
    .is-invalid {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 .15rem rgba(220,53,69,.15);
    }
    .checkout-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }

    .address-card {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 16px;
        margin-bottom: 12px;
        border: 1px solid #eee;
        border-radius: 14px;
        cursor: pointer;
        transition: .2s;
    }

        .address-card:hover {
            background: #fff7f6;
        }

    .checkout-total {
        font-size: 28px;
        font-weight: 700;
        color: #72D572;
    }

    #comment {
        resize: none;
    }

    .addresses-container {
        max-height: 330px;
        overflow-y: auto;
        padding-right: 6px;
    }

</style>
<script>

    document
    .querySelectorAll('input[name="addressId"]')
    .forEach(radio => {

        radio.addEventListener('change', function () {

            const block =
                document.getElementById(
                    'newAddressBlock');

            if (this.value == "0")
            {
                block.style.display = "block";
            }
            else
            {
                block.style.display = "none";
            }

        });

    });

</script>
<script>

    function clearValidation()
    {
        document
            .querySelectorAll('.is-invalid')
            .forEach(x => x.classList.remove('is-invalid'));
    }

</script>
<script>
        document
    .getElementById('openPaymentModal')
    .addEventListener('click', function () {

        const modal =
            new bootstrap.Modal(
                document.getElementById('paymentModal')
            );

        modal.show();

    });
    document
    .getElementById('createOrderBtn')
    .addEventListener('click', async () => {

        clearValidation();

        const selectedAddress =
            document.querySelector(
                'input[name="addressId"]:checked');

        const formData =
            new URLSearchParams();

        if (selectedAddress)
        {
            formData.append(
                'addressId',
                selectedAddress.value);
        }

        formData.append(
            'newAddress',
            document.getElementById('newAddress')?.value ?? '');

        formData.append(
            'recipientName',
            document.getElementById('recipientName')?.value ?? '');

        formData.append(
            'recipientPhone',
            document.getElementById('recipientPhone')?.value ?? '');

        formData.append(
            'comment',
            document.getElementById('comment').value);
                const paymentMethod =
        document.querySelector(
            'input[name="paymentMethod"]:checked'
        )?.value;

    formData.append(
        'paymentMethod',
        paymentMethod);

        formData.append(
            'saveAddress',
            document.getElementById('saveAddress')?.checked ?? false);
                const isNewAddress =
        selectedAddress &&
        selectedAddress.value == "0";

    if (isNewAddress)
    {
        const address =
            document.getElementById('newAddress')
            .value.trim();

        const recipient =
            document.getElementById('recipientName')
            .value.trim();

        const phone =
            document.getElementById('recipientPhone')
            .value.trim();

    if (!address)
    {
        document
            .getElementById('newAddress')
            .classList.add('is-invalid');

        toastr.error("Введите адрес доставки");
        return;
    }

    if (address.length < 5)
    {
        document
            .getElementById('newAddress')
            .classList.add('is-invalid');

        toastr.error("Введите полный адрес");
        return;
    }

    if (!recipient)
    {
        document
            .getElementById('recipientName')
            .classList.add('is-invalid');

        toastr.error("Введите имя получателя");
        return;
    }

    if (recipient.length < 2)
    {
        document
            .getElementById('recipientName')
            .classList.add('is-invalid');

        toastr.error(
            "Имя получателя должно содержать минимум 2 буквы"
        );
        return;
    }

    if (/\d/.test(recipient))
    {
        document
            .getElementById('recipientName')
            .classList.add('is-invalid');

        toastr.error(
            "Имя получателя не должно содержать цифры"
        );
        return;
    }

        const nameRegex =
            /^[А-Яа-яЁёA-Za-z\s-]+$/;

    if (!nameRegex.test(recipient))
    {
        document
            .getElementById('recipientName')
            .classList.add('is-invalid');

        toastr.error(
            "Имя получателя может содержать только буквы, пробелы и дефис"
        );
        return;
    }

        const phoneRegex =
            /^\+7\d{10}$/;

    if (!phoneRegex.test(phone))
    {
        document
            .getElementById('recipientPhone')
            .classList.add('is-invalid');

        toastr.error(
            "Введите корректный номер телефона"
        );
        return;
    }
    }
        const response =
            await fetch('/Cart/CreateOrder', {

                method: 'POST',

                headers: {
                    'Content-Type':
                    'application/x-www-form-urlencoded'
                },

                body: formData
            });

        const result =
            await response.json();

    if (result.success)
    {
        window.location = result.redirectUrl;
    }
        else
        {
            toastr.error(result.message);
        }
    });
        document.addEventListener('DOMContentLoaded', function () {

        const phoneInput =
            document.getElementById('recipientPhone');

        if (!phoneInput)
            return;

        phoneInput.addEventListener('focus', function () {

            if (!this.value) {
                this.value = '+7';
            }

        });

        phoneInput.addEventListener('input', function () {

            let value =
                this.value.replace(/[^\d+]/g, '');

            if (!value.startsWith('+7')) {
                value = '+7';
            }

            value =
                '+7' +
                value.substring(2)
                     .replace(/\D/g, '');

            if (value.length > 12) {
                value = value.substring(0, 12);
            }

            this.value = value;
        });

    });
    document
    .querySelectorAll(
        '#newAddress, #recipientName, #recipientPhone'
    )
    .forEach(input => {

        input.addEventListener('input', function () {

            this.classList.remove('is-invalid');

        });

    });
</script>
