@model List<FlowerShop.Models.CartItem>

@{
    ViewData["Title"] = "Корзина";

    decimal total = Model.Sum(x =>
        (x.Product?.Price ?? 0) * x.Quantity);
    decimal totalWithoutDiscount = Model.Sum(x =>
        (x.Product?.Price ?? 0m) * x.Quantity);

    decimal totalWithDiscount = Model.Sum(x =>
        (x.Product?.Price ?? 0m) *
        (100 - (x.Product?.DiscountPercentage ?? 0)) / 100m *
        x.Quantity);

    decimal discountAmount =
        totalWithoutDiscount - totalWithDiscount;
}

<div class="container py-5">

    <h1 class="mb-4">
        Корзина
    </h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Корзина пуста
        </div>
    }
    else
    {
        <div class="cart-layout">
        <div class="cart-items">

            @foreach (var item in Model)
            {
                var price =
                (item.Product?.Price ?? 0m) *
                (100 - (item.Product?.DiscountPercentage ?? 0))
                / 100m;

                var sum =
                price * item.Quantity;

                <div class="cart-item-card"
                     data-cart-item="@item.Id">

                    <div class="cart-image">

                        <img src="@(string.IsNullOrEmpty(item.Product?.Picture)
                                                 ? "/images/no-image.jpg"
                                                 : item.Product.Picture)"
                     alt="@item.Product?.Name">

                    </div>

                    <div class="cart-info">

                        <h5 class="cart-name">
                            @item.Product?.Name
                        </h5>
                            <div class="stock-info">
                                В наличии: @item.Product?.StockQuantity шт.
                            </div>

                        <div class="cart-price">

                            Цена за штуку:

                                <span class="product-price-value">
                                    @price.ToString("N0") ₽
                                </span>

                        </div>

                    </div>

                        <div class="cart-actions">

                            <div class="cart-sum"
                                 data-price="@price">

                                @sum.ToString("N0") ₽

                            </div>


                            <div class="cart-quantity">

                                <button class="qty-btn minus-btn"
                                        data-id="@item.Id">
                                    −
                                </button>

                                <span class="qty-value">
                                    @item.Quantity
                                </span>

                                <button class="qty-btn plus-btn"
                                        data-id="@item.Id">
                                    +
                                </button>

                            </div>

                        </div>

                </div>
                }

        </div>

        <div class="cart-total-box">
                <div class="summary-title">
                    Ваш заказ
                </div>
            <div class="summary-row">
                <span>Товаров в корзине</span>
                <strong>@Model.Sum(x => x.Quantity)</strong>
            </div>

            <div class="summary-row">
                <span>Стоимость товаров</span>
                <strong>@totalWithoutDiscount.ToString("N0") ₽</strong>
            </div>

                <div class="summary-row discount-row">

                    <span>
                        Скидка
                    </span>

                    <div class="discount-badge">
                        -@discountAmount.ToString("N0") ₽
                    </div>

                </div>

            <hr />

                <div class="cart-total" id="cartTotal">
                    Итого:
                @totalWithDiscount.ToString("N0") ₽
            </div>
            <a asp-controller="Cart"
               asp-action="Checkout"
               class="btn checkout-btn mt-3">

                Оформить заказ

            </a>
            </div>
        </div>
    }

</div>
<script>
        function updateCartTotals() {

        let total = 0;

        document.querySelectorAll('.cart-item-card')
        .forEach(card => {

            const quantity =
                parseInt(
                    card.querySelector('.qty-value')
                    .textContent);

            const price =
                parseFloat(
                    card.querySelector('.cart-sum')
                    .dataset.price);

            const sum =
                quantity * price;

            card.querySelector('.cart-sum')
                .textContent =
                sum.toLocaleString('ru-RU') + ' ₽';

            total += sum;
        });

        document.getElementById('cartTotal')
            .textContent =
            'Итого: ' +
            total.toLocaleString('ru-RU') +
            ' ₽';
    }
    document.querySelectorAll('.plus-btn')
    .forEach(btn => {

        btn.addEventListener('click', async function () {

            const cartItemId =
                this.dataset.id;

            const response =
                await fetch('/Cart/Increase', {

                    method: 'POST',

                    headers: {
                        'Content-Type':
                        'application/x-www-form-urlencoded'
                    },

                    body:
                        `cartItemId=${cartItemId}`
                });

            const result =
                await response.json();

            if (result.success)
            {
    this.parentElement
    .querySelector('.qty-value')
    .textContent =
    result.quantity;

    updateCartTotals();
            }
        });
    });

    document.querySelectorAll('.minus-btn')
    .forEach(btn => {

        btn.addEventListener('click', async function () {

            const cartItemId =
                this.dataset.id;
                    const currentQty =
        parseInt(
            this.parentElement
                .querySelector('.qty-value')
                .textContent);

    if (currentQty === 1)
    {
        if (!confirm('Удалить товар из корзины?'))
            return;

        const response =
            await fetch('/Cart/Remove', {

                method: 'POST',

                headers: {
                    'Content-Type':
                    'application/x-www-form-urlencoded'
                },

                body:
                    `cartItemId=${cartItemId}`
            });

        const result =
            await response.json();

        if (result.success)
        {
            this.closest('.cart-item-card')
                .remove();

            updateCartTotals();

            if (
                document.querySelectorAll('.cart-item-card')
                .length === 0
            )
            {
                location.reload();
            }
        }

        return;
    }

            const response =
                await fetch('/Cart/Decrease', {

                    method: 'POST',

                    headers: {
                        'Content-Type':
                        'application/x-www-form-urlencoded'
                    },

                    body:
                        `cartItemId=${cartItemId}`
                });

            const result =
                await response.json();

            if (result.success)
            {
                this.parentElement
                    .querySelector('.qty-value')
                    .textContent =
                    result.quantity;

    updateCartTotals();
            }
        });
    });
      
</script>
<style>
    .cart-layout {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 30px;
        align-items: start;
    }
.cart-items {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.cart-item-card {
    display: flex;
    align-items: center;
    gap: 20px;
        background: white;
        border: 1px solid #eeeeee;

    border-radius: 18px;
        padding: 14px 18px;
        min-height: 120px;
    box-shadow: 0 4px 16px rgba(0,0,0,.08);
}

    .cart-image img {
        width: 130px;
        height: 130px;
        object-fit: cover;
        border-radius: 16px;
    }

.cart-info {
    flex: 1;
}

    .cart-name {
        margin-bottom: 10px;
        font-weight: 700;
        font-size: 22px;
    }

    .cart-price {
        color: #777;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 16px;
    }

    .cart-quantity {
        background: #fff0f5;
        border: 1px solid #ffd2de;
        border-radius: 999px;
        padding: 6px 10px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .qty-btn {
        width: 38px;
        height: 38px;
        border: none;
        border-radius: 50%;
        background: #f4a6b5;
        color: white;
        font-size: 20px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .2s;
    }

    .qty-value {
        min-width: 24px;
        text-align: center;
        font-size: 18px;
        font-weight: 700;
        color: #d87093;
    }

    .qty-btn:hover {
        background: #e88ca0;
        transform: scale(1.1);
    }

    .cart-sum {
        width: 140px;
        text-align: right;
        font-size: 28px;
        font-weight: 800;
        color: #212529;
    }

    .cart-total-box {
        position: sticky;
        top: 100px;
        background: white;
        border: 1px solid #eeeeee;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,.12);
    }

    .cart-total {
        font-size: 28px;
        font-weight: 700;
        color: #d87093;
    }

    .cart-item-card {
        transition: .25s;
    }

        .cart-item-card:hover {
            transform: translateY(-4px);
            border-color: #f4a6b5;
            box-shadow: 0 10px 30px rgba(244,166,181,.25);
        }

    .checkout-btn {
        min-width: 260px;
        height: 58px;
        border-radius: 16px;
        font-size: 18px;
        font-weight: 700;
        background: #f4a6b5;
        border: none;
        color: white;
        transition: .2s;
    }

        .checkout-btn:hover {
            background: #e88ca0;
            color: white;
        }

    .cart-header-card {
        background: linear-gradient( 135deg, #fff0f5, #ffe4ec );
        border: 1px solid #ffd2de;
        border-radius: 20px;
        padding: 20px 25px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }

    .cart-header-title {
        color: #777;
        font-size: 14px;
    }

    .cart-header-value {
        font-size: 28px;
        font-weight: 800;
    }

    .total-pink {
        color: #212529;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: 18px;
    }

        .summary-row span {
            color: #666;
        }

        .summary-row strong {
            font-size: 18px;
        }

    .discount-row strong {
        color: #212529;
    }

    .cart-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 30px;
        font-weight: 800;
        margin-top: 15px;
    }

    .cart-total-box hr {
        margin: 18px 0;
        opacity: .15;
    }

    .summary-title {
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 25px;
    }

    .discount-badge {
        background: #fff0f5;
        color: #d87093;
        padding: 6px 12px;
        border-radius: 999px;
        font-weight: 700;
    }

    .product-price-value {
        font-size: 16px;
        font-weight: 400;
        color: #777;
    }

    .stock-info {
        margin-top: 6px;
        color: #999;
        font-size: 14px;
    }

    .cart-actions {
        width: 170px;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
    }

    .cart-quantity {
        margin-top: 10px;
    }
</style>