        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 30px;
        align-items: start;
    }
.cart-items {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

    .cart-item-card {
        display: flex;
        align-items: center;
        gap: 20px;
        background: white;
        border: 1px solid #eeeeee;
        border-radius: 18px;
        padding: 14px 18px;
        min-height: 120px;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }

    .cart-image img {
        width: 130px;
        height: 130px;
        object-fit: cover;
        border-radius: 16px;
    }

    .cart-info {
        flex: 1;
    }

    .cart-name {
        margin-bottom: 10px;
        font-weight: 700;
        font-size: 24px;
        line-height: 1.2;
        max-width: 500px;
        word-break: break-word;
    }

    .cart-quantity {
        background: #fff0f5;
        border: 1px solid #ffd2de;
        border-radius: 999px;
        padding: 6px 10px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .qty-btn {
        width: 38px;
        height: 38px;
        border: none;
        border-radius: 50%;
        background: #ffbbb7;
        color: white;
        font-size: 20px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .2s;
    }

        .qty-btn:hover {
            background: #ffaaa5;
            transform: scale(1.1);
        }

    .cart-sum {
        width: 140px;
        text-align: right;
        font-size: 28px;
        font-weight: 700;
        color: #212529;
    }

    .cart-total-box {
        position: sticky;
        top: 100px;
        background: white;
        border: 1px solid #eeeeee;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,.12);
    }

    .cart-total {
        font-size: 28px;
        font-weight: 700;
        color: #212529;
    }

    .cart-item-card {
        transition: .25s;
    }

        .cart-item-card:hover {
            transform: translateY(-4px);
            border-color: #f4a6b5;
            box-shadow: 0 10px 30px rgba(244,166,181,.25);
        }

    .checkout-btn {
        width: 100%;
        height: 58px;
        border-radius: 12px;
        background: #ffbbb7;
        border: 1px solid #ffbbb7;
        color: #222 !important;
        font-family: "Trebuchet MS", sans-serif;
        font-size: 16px;
        font-weight: 400;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        box-shadow: 0 4px 12px rgba(255, 187, 183, .35);
        transition: all .25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

        .checkout-btn:hover {
            background: #ffaea9;
            border-color: #ffaea9;
            color: #111 !important;
            transform: translateY(-2px);
        }

    .cart-header-card {
        background: linear-gradient( 135deg, #fff0f5, #ffe4ec );
        border: 1px solid #ffd2de;
        border-radius: 20px;
        padding: 20px 25px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }

    .cart-header-title {
        color: #777;
        font-size: 14px;
    }

    .cart-header-value {
        font-size: 28px;
        font-weight: 800;
    }

    .total-pink {
        color: #212529;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: 18px;
    }

        .summary-row span {
            color: #666;
        }

        .summary-row strong {
            font-size: 18px;
        }

    .discount-row strong {
        color: #212529;
    }

    .cart-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 30px;
