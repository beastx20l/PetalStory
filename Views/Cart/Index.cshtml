@model List<FlowerShop.Models.CartItem>

@{
    ViewData["Title"] = "Корзина";

    decimal total = Model.Sum(x =>
        (x.Product?.Price ?? 0) * x.Quantity);
}

<div class="container py-5">

    <h1 class="mb-4">
        Корзина
    </h1>
    <div class="cart-header-card">

        <div>
            <div class="cart-header-title">
                Товаров в корзине
            </div>

            <div class="cart-header-value">
                @Model.Sum(x => x.Quantity)
            </div>
        </div>

        <div>
            <div class="cart-header-title">
                Общая сумма
            </div>

            <div class="cart-header-value text-success">
                @total.ToString("N0") ₽
            </div>
        </div>

    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Корзина пуста
        </div>
    }
    else
    {
        <div class="cart-items">

            @foreach (var item in Model)
            {
                var price =
                item.Product?.Price ?? 0;

                var sum =
                price * item.Quantity;

                <div class="cart-item-card"
                     data-cart-item="@item.Id">

                    <div class="cart-image">

                        <img src="@(string.IsNullOrEmpty(item.Product?.Picture)
                                                 ? "/images/no-image.jpg"
                                                 : item.Product.Picture)"
                     alt="@item.Product?.Name">

                    </div>

                    <div class="cart-info">

                        <h5 class="cart-name">
                            @item.Product?.Name
                        </h5>

                        <div class="cart-price">

                            Цена за штуку

                            <span>
                                @price.ToString("N0") ₽
                            </span>

                        </div>

                    </div>

                    <div class="cart-quantity">

                        <button class="qty-btn minus-btn"
                                data-id="@item.Id">
                            −
                        </button>

                        <span class="qty-value">
                            @item.Quantity
                        </span>

                        <button class="qty-btn plus-btn"
                                data-id="@item.Id">
                            +
                        </button>

                    </div>

                    <div class="cart-sum"
                         data-price="@price">

                        @sum.ToString("N0") ₽

                    </div>

                    <button class="remove-btn delete-btn"
                            data-id="@item.Id">

                        <i class="fa-solid fa-trash"></i>

                    </button>

                </div>
                }

        </div>

        <div class="cart-total-box">

            <div class="cart-total"
                 id="cartTotal">

                Итого:
                @total.ToString("N0") ₽

            </div>

            <a asp-controller="Cart"
               asp-action="Checkout"
               class="btn btn-success checkout-btn">

                Оформить заказ

            </a>

        </div>
    }

</div>
<script>
        function updateCartTotals() {

        let total = 0;

        document.querySelectorAll('.cart-item-card')
        .forEach(card => {

            const quantity =
                parseInt(
                    card.querySelector('.qty-value')
                    .textContent);

            const price =
                parseFloat(
                    card.querySelector('.cart-sum')
                    .dataset.price);

            const sum =
                quantity * price;

            card.querySelector('.cart-sum')
                .textContent =
                sum.toLocaleString('ru-RU') + ' ₽';

            total += sum;
        });

        document.getElementById('cartTotal')
            .textContent =
            'Итого: ' +
            total.toLocaleString('ru-RU') +
            ' ₽';
    }
    document.querySelectorAll('.plus-btn')
    .forEach(btn => {

        btn.addEventListener('click', async function () {

            const cartItemId =
                this.dataset.id;

            const response =
                await fetch('/Cart/Increase', {

                    method: 'POST',

                    headers: {
                        'Content-Type':
                        'application/x-www-form-urlencoded'
                    },

                    body:
                        `cartItemId=${cartItemId}`
                });

            const result =
                await response.json();

            if (result.success)
            {
    this.parentElement
    .querySelector('.qty-value')
    .textContent =
    result.quantity;

    updateCartTotals();
            }
        });
    });

    document.querySelectorAll('.minus-btn')
    .forEach(btn => {

        btn.addEventListener('click', async function () {

            const cartItemId =
                this.dataset.id;

            const response =
                await fetch('/Cart/Decrease', {

                    method: 'POST',

                    headers: {
                        'Content-Type':
                        'application/x-www-form-urlencoded'
                    },

                    body:
                        `cartItemId=${cartItemId}`
                });

            const result =
                await response.json();

            if (result.success)
            {
                this.parentElement
                    .querySelector('.qty-value')
                    .textContent =
                    result.quantity;

    updateCartTotals();
            }
        });
    });
        document.querySelectorAll('.delete-btn')
    .forEach(btn => {

        btn.addEventListener('click', async function () {

            if (!confirm('Удалить товар из корзины?'))
                return;

            const cartItemId =
                this.dataset.id;

            const response =
                await fetch('/Cart/Remove', {

                    method: 'POST',

                    headers: {
                        'Content-Type':
                        'application/x-www-form-urlencoded'
                    },

                    body:
                        `cartItemId=${cartItemId}`
                });

            const result =
                await response.json();

            if (result.success)
            {
                this.closest('.cart-item-card')
                    .remove();

                updateCartTotals();

                toastr.success(
                    'Товар удалён'
                );

                if (
                    document.querySelectorAll('.cart-item-card')
                    .length === 0
                )
                {
                    location.reload();
                }
            }
        });
    });
</script>
<style>
.cart-items {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.cart-item-card {
    display: flex;
    align-items: center;
    gap: 20px;

    background: white;

    border-radius: 18px;
        padding: 14px 18px;
        min-height: 120px;
    box-shadow: 0 4px 16px rgba(0,0,0,.08);
}

    .cart-image img {
        width: 130px;
        height: 130px;
        object-fit: cover;
        border-radius: 16px;
    }

.cart-info {
    flex: 1;
}

    .cart-name {
        margin-bottom: 10px;
        font-weight: 700;
        font-size: 22px;
    }

.cart-price {
    color: #777;
}

.cart-quantity {
        background: #f7f7f7;
        border-radius: 50px;
        padding: 8px 12px;
}

    .qty-btn {
        width: 38px;
        height: 38px;
        background: #ffbbb7;
        font-size: 20px;
    }

    .qty-value {
        min-width: 30px;
        text-align: center;
        font-weight: 700;
    }
        .qty-btn:hover {
            background: #ff9d96;
            transform: scale(1.08);
        }

    .cart-sum {
        width: 140px;
        text-align: right;
        font-size: 28px;
        font-weight: 800;
        color: #198754;
    }

.remove-btn {
    border: none;
    background: transparent;

    color: #dc3545;

    font-size: 18px;
}

    .cart-total-box {
        position: sticky;
        bottom: 20px;
        background: white;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,.12);
    }

.cart-total {
    font-size: 28px;
    font-weight: 700;
}

    .cart-item-card {
        transition: .25s;
    }

        .cart-item-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(0,0,0,.12);
        }

    .checkout-btn {
        min-width: 260px;
        height: 58px;
        border-radius: 16px;
        font-size: 18px;
        font-weight: 700;
    }

    .cart-header-card {
        background: white;
        border-radius: 20px;
        padding: 20px 25px;
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }

    .cart-header-title {
        color: #777;
        font-size: 14px;
    }

    .cart-header-value {
        font-size: 28px;
        font-weight: 800;
    }
</style>