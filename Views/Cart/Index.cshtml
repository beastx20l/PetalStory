    }

    .summary-title {
        font-size: 24px;
        font-weight: 600;
        margin-bottom: 25px;
    }

    .discount-badge {
        background: transparent;
        color: #72D572;
        padding: 0;
        border-radius: 0;
        font-weight: 700;
    }

    .stock-info {
        margin-top: 6px;
        color: #999;
        font-size: 14px;
    }

    .cart-actions {
        width: 170px;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 12px;
    }

    .cart-quantity {
        margin-top: 10px;
    }

.discount-tag {
    background: #fff0f5;
    color: #d87093;

    padding: 4px 10px;

    border-radius: 999px;

    font-size: 12px;
    font-weight: 700;

    display: inline-flex;
    align-items: center;

    height: 26px;
}

    .price-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .old-price {
        font-size: 26px;
        font-weight: 700;
        color: #b0b0b0;
        text-decoration: line-through;
    }

    .new-price {
        font-size: 26px;
        font-weight: 700;
        color: #212529;
    }

    .product-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
        margin-top: 12px;
    }

    .product-prices {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 6px;
    }
</style>