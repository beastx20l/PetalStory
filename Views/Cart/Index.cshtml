@model List<FlowerShop.Models.CartItem>

@{
    ViewData["Title"] = "Корзина";

    decimal total = Model.Sum(x =>
        (x.Product?.Price ?? 0) * x.Quantity);
    decimal totalWithoutDiscount = Model.Sum(x =>
        (x.Product?.Price ?? 0m) * x.Quantity);

    decimal totalWithDiscount = Model.Sum(x =>
    {
        var oldPrice = x.Product?.Price ?? 0m;
        var discount = x.Product?.DiscountPercentage ?? 0;

        var discountedPrice =
            Math.Floor(
                oldPrice * (100 - discount) / 100m
            );

        return discountedPrice * x.Quantity;
    });

    decimal discountAmount =
        totalWithoutDiscount - totalWithDiscount;
}

<div class="container py-5">

    <h1 class="mb-4">
        Корзина
    </h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Корзина пуста
        </div>
    }
    else
    {
        <div class="cart-layout">
        <div class="cart-items">

            @foreach (var item in Model)
            {
                    var oldPrice =
                    item.Product?.Price ?? 0m;

                    var discount =
                    item.Product?.DiscountPercentage ?? 0;

                    var price =
                    Math.Round(
                    oldPrice * (100 - discount) / 100m,
                    0,
                    MidpointRounding.AwayFromZero
                    );

                var sum =
                price * item.Quantity;

                    <div class="cart-item-card"
                         data-cart-item="@item.Id"
                         data-stock="@(item.Product?.StockQuantity ?? 0)"
                         data-old-price="@oldPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-discount="@discount">

                    <div class="cart-image">

                        <img src="@(string.IsNullOrEmpty(item.Product?.Picture)
                                                 ? "/images/no-image.jpg"
                                                 : item.Product.Picture)"
                     alt="@item.Product?.Name">

                    </div>

                        <div class="cart-info">

                            <div class="product-header">

                                <h5 class="cart-name">
                                    @item.Product?.Name
                                </h5>

                            </div>

                            <div class="product-prices">

                                <span class="new-price">
                                    @price.ToString("N0") ₽
                                </span>

                        @if (discount > 0)
                                {
                                    <span class="old-price">
                                        @oldPrice.ToString("N0") ₽
                                    </span>

                                    <span class="discount-tag">
                                        -@discount%
                                    </span>
                                }

                            </div>

                            <div class="stock-info">
                                В наличии: @item.Product?.StockQuantity шт.
                            </div>

                        </div>

                        <div class="cart-actions">

                            <div class="cart-sum"
                                 data-price="@price.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                @sum.ToString("N0") ₽

                            </div>


                            <div class="cart-quantity">

                                <button class="qty-btn minus-btn"
                                        data-id="@item.Id">
                                    −
                                </button>

                                <span class="qty-value">
                                    @item.Quantity
                                </span>

                                <button class="qty-btn plus-btn"
                                        data-id="@item.Id">
                                    +
                                </button>

                            </div>

                        </div>

                </div>
                }

        </div>

        <div class="cart-total-box">
                <div class="summary-title">
                    Ваш заказ
                </div>
                <div class="summary-row">
                    <span>Товаров в корзине</span>
                    <strong id="summaryQuantity">
                        @Model.Sum(x => x.Quantity)
                    </strong>
                </div>

                <div class="summary-row">
                    <span>Стоимость товаров</span>
                    <strong id="summaryPrice">
                        @totalWithoutDiscount.ToString("N0") ₽
                    </strong>
                </div>

                <div class="summary-row discount-row">
                    <span>Скидка</span>

                    <div class="discount-badge" id="summaryDiscount">
                        -@discountAmount.ToString("N0") ₽
                    </div>
                </div>

            <hr />

                <div class="cart-total">
                    <span>Итого</span>

                    <strong id="cartTotal">
                        @totalWithDiscount.ToString("N0") ₽
                    </strong>
                </div>
            <a asp-controller="Cart"
               asp-action="Checkout"
               class="btn checkout-btn mt-3">

                Оформить заказ

            </a>
            </div>
        </div>
    }
    <div class="modal fade" id="deleteCartItemModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Подтверждение удаления
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body text-center py-4">

                    <i class="fa fa-trash text-danger mb-3"
                       style="font-size:42px;">
                    </i>

                    <p class="fs-5 mb-0">
                        Удалить товар из корзины?
                    </p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Отмена
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            id="confirmRemoveCartItem">
                        Удалить
                    </button>

                </div>

            </div>
        </div>
    </div>
</div>
<script>
    let cartItemToDelete = null;
                document
    .getElementById('confirmRemoveCartItem')
    .addEventListener('click', async function () {

        if (!cartItemToDelete)
            return;

        const response = await fetch('/Cart/Remove', {

            method: 'POST',

            headers: {
                'Content-Type':
                'application/x-www-form-urlencoded'
            },

            body:
                `cartItemId=${cartItemToDelete.id}`
        });

        const result = await response.json();

        if (result.success) {

            cartItemToDelete.card.remove();
            document.getElementById('cart-count').textContent =
            result.cartCount;

            updateCartTotals();

            toastr.success(
                'Товар удалён из корзины'
            );

            bootstrap.Modal
                .getInstance(
                    document.getElementById('deleteCartItemModal')
                )
                .hide();

            if (
                document.querySelectorAll('.cart-item-card')
                    .length === 0
            ) {
                location.reload();
            }
        }
        else {

            toastr.error(
                'Не удалось удалить товар'
            );
        }

        cartItemToDelete = null;
    });
    // Обновление состояния кнопки "+" (активна/неактивна)
    function updateCartItemUI(card) {
        const qtyEl = card.querySelector('.qty-value');
        const plusBtn = card.querySelector('.plus-btn');
        const stock = parseInt(card.dataset.stock || '0');
        const currentQty = parseInt(qtyEl.textContent);

        if (currentQty >= stock) {
            plusBtn.disabled = true;
            plusBtn.style.opacity = '0.45';
            plusBtn.style.cursor = 'not-allowed';
        } else {
            plusBtn.disabled = false;
            plusBtn.style.opacity = '1';
            plusBtn.style.cursor = 'pointer';
        }
    }

    // Инициализация при загрузке
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.cart-item-card').forEach(card => {
            updateCartItemUI(card);
        });
    });

    // === Увеличение количества (+)
    document.querySelectorAll('.plus-btn').forEach(btn => {
        btn.addEventListener('click', async function () {
            const card = this.closest('.cart-item-card');
            const stock = parseInt(card.dataset.stock || '0');
            const qtyEl = card.querySelector('.qty-value');
            let currentQty = parseInt(qtyEl.textContent);

            if (currentQty >= stock) {
                toastr.warning('Больше нет в наличии!');
                return;
            }

            const cartItemId = this.dataset.id;

            const response = await fetch('/Cart/Increase', {
                   method: 'POST',
    headers: {
        'Content-Type': 'application/x-www-form-urlencoded'
    },
    body: `cartItemId=${cartItemId}`
    });

    const result = await response.json();

    if (result.success) {

        qtyEl.textContent = result.quantity;

        document.getElementById('cart-count').textContent =
            result.cartCount;

        updateCartItemUI(card);
        updateCartTotals();
    }
        });
    });
    

    // === Уменьшение количества (-)
    document.querySelectorAll('.minus-btn').forEach(btn => {
        btn.addEventListener('click', async function () {
            const cartItemId = this.dataset.id;
            const card = this.closest('.cart-item-card');
            const qtyEl = card.querySelector('.qty-value');
            let currentQty = parseInt(qtyEl.textContent);

    if (currentQty === 1) {

        cartItemToDelete = {
            id: cartItemId,
            card: card
        };

        const modal = new bootstrap.Modal(
            document.getElementById('deleteCartItemModal')
        );

        modal.show();

        return;
    }

            // Обычное уменьшение
            const response = await fetch('/Cart/Decrease', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `cartItemId=${cartItemId}`
            });

            const result = await response.json();
    if (result.success) {

        qtyEl.textContent = result.quantity;

        document.getElementById('cart-count').textContent =
            result.cartCount;

        updateCartItemUI(card);
        updateCartTotals();
    }
        });
    });

    // === Обновление итогов ===
    function updateCartTotals() {

        let totalQuantity = 0;
        let totalWithoutDiscount = 0;
        let totalWithDiscount = 0;

        document.querySelectorAll('.cart-item-card').forEach(card => {

            const quantity =
                parseInt(card.querySelector('.qty-value').textContent);

            const discountedPrice =
                parseFloat(card.querySelector('.cart-sum').dataset.price);

            const oldPrice =
                parseFloat(card.dataset.oldPrice);
          
            totalQuantity += quantity;

            totalWithoutDiscount += oldPrice * quantity;

            totalWithDiscount += discountedPrice * quantity;

    const sum = discountedPrice * quantity;

    card.querySelector('.cart-sum').textContent =
        Math.round(sum).toLocaleString('ru-RU') + ' ₽';
        });

        const discount =
            totalWithoutDiscount - totalWithDiscount;
            document.getElementById('summaryQuantity').textContent =
    totalQuantity;
           document.getElementById('summaryPrice').textContent =
        Math.round(totalWithoutDiscount).toLocaleString('ru-RU') + ' ₽';

    document.getElementById('summaryDiscount').textContent =
        '-' + Math.round(discount).toLocaleString('ru-RU') + ' ₽';

    document.getElementById('cartTotal').textContent =
        Math.round(totalWithDiscount).toLocaleString('ru-RU') + ' ₽';

        const cartBadge = document.getElementById('cart-count');

        if (cartBadge) {
        cartBadge.textContent = totalQuantity;
        }
    }
</script>
<style>
