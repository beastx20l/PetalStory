<script>

    const minSlider =
        document.getElementById('minPrice');

    const maxSlider =
        document.getElementById('maxPrice');

    const minText =
        document.getElementById('minPriceText');

    const maxText =
        document.getElementById('maxPriceText');
        const sliderRange =
    document.getElementById('sliderRange');

        function updatePriceSlider(e) {

        let min = parseInt(minSlider.value);
        let max = parseInt(maxSlider.value);

        if (e && e.target === minSlider && min >= max) {

            min = max - 100;
            minSlider.value = min;
        }

        if (e && e.target === maxSlider && max <= min) {

            max = min + 100;
            maxSlider.value = max;
        }

        minText.value = min;

        maxText.value =
            max >= 10000
            ? '10000+'
            : max;

        updateRangeBackground();
    }

        minSlider.addEventListener('input', function (e) {
        updatePriceSlider(e);
    });

    maxSlider.addEventListener('input', function (e) {
        updatePriceSlider(e);
    });
    updateRangeBackground();
    updatePriceSlider();
        function updateRangeBackground() {

        const min = parseInt(minSlider.value);
        const max = parseInt(maxSlider.value);

        const left = (min / 10000) * 100;
        const right = (max / 10000) * 100;

        sliderRange.style.left = left + "%";
        sliderRange.style.width = (right - left) + "%";
    }

    minText.addEventListener('change', function () {

        let value = parseInt(this.value) || 0;

        if (value < 0)
            value = 0;

        if (value > 10000)
            value = 10000;

        minSlider.value = value;

        updatePriceSlider();
        updateRangeBackground();
    });

    maxText.addEventListener('change', function () {

        let value =
            parseInt(this.value.replace('+', '')) || 10000;

        if (value < 0)
            value = 0;

        if (value > 10000)
            value = 10000;

        maxSlider.value = value;

        updatePriceSlider();
        updateRangeBackground();
    });

    minSlider.addEventListener('input', updateRangeBackground);
    maxSlider.addEventListener('input', updateRangeBackground);

    updateRangeBackground();
</script>
