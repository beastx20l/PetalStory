    }

    .categories-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
        margin-bottom: 20px;
    }

.scroll-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;

    background: white;

    display: flex;
    align-items: center;
    justify-content: center;

