@model List<FlowerShop.Models.Product>

@{
    ViewData["Title"] = "Каталог товаров";

    var minPrice =
        Context.Request.Query["minPrice"]
        .FirstOrDefault() ?? "0";

    var maxPrice =
        Context.Request.Query["maxPrice"]
        .FirstOrDefault() ?? "10000";
    ViewBag.MinPrice = minPrice;
    ViewBag.MaxPrice = maxPrice;
}

<div class="container py-5">
    <h1 class="catalog-title">
        Каталог цветов
    </h1>

    <p class="catalog-subtitle">
        Авторские букеты и цветочные композиции
    </p>
    <div style="height:40px;"></div>
    <div class="catalog-layout">

        <div class="catalog-sidebar">

            <div class="text-center mb-4">



                @{
                    var categories =
                    ViewBag.Categories as List<FlowerShop.Models.Category>
                    ?? new List<FlowerShop.Models.Category>();

                    int? selectedParentCategory =
                    ViewBag.SelectedParentCategory as int?;

                    int? selectedChildCategory =
                    ViewBag.SelectedChildCategory as int?;
                }

                @{
                    int parentPage = (int)(ViewBag.ParentPage ?? 1);
                    int parentPages = (int)(ViewBag.ParentPages ?? 1);
                    bool showParentPaging = parentPages > 1;

                    var visibleParents = categories
                    .Where(x => x.ParentCategoryId == null)
                    .OrderBy(x => x.Id)
                    .ToList();
                }
                <div class="filter-title-chip category-toggle"
                     onclick="togglePrice()">
                    Цена
                </div>

                <div class="price-wrapper" id="priceBlock">

                    <div class="price-filter">

                        <div class="price-inputs">

                            <input type="text"
                                   id="minPriceText"
                                   value="@ViewBag.MinPrice" />

                            <input type="text"
                                   id="maxPriceText"
                                   value="@(ViewBag.MaxPrice == "10000" ? "10000+" : ViewBag.MaxPrice)" />

                        </div>

                        <div class="range-slider">

                            <div class="slider-track"></div>
                            <div class="slider-range" id="sliderRange"></div>

                            <input type="range"
                                   id="minPrice"
                                   min="0"
                                   max="10000"
                                   step="100"
                                   value="@ViewBag.MinPrice">

                            <input type="range"
                                   id="maxPrice"
                                   min="0"
                                   max="10000"
                                   step="100"
                                   value="@ViewBag.MaxPrice">

                        </div>
                    </div>
                </div>
                <div class="filter-title-chip category-toggle" onclick="toggleCategories()">
                    Тип букета
                </div>
                <div class="categories-wrapper" id="categoriesBlock">



                    <div class="catalog-categories">
                        @foreach (var parent in visibleParents)
                        {
                            <a asp-action="Index"
                               asp-route-parentCategoryId="@parent.Id"
                               asp-route-minPrice="@ViewBag.MinPrice"
                               asp-route-maxPrice="@ViewBag.MaxPrice"
                               asp-route-sort="@ViewBag.Sort"
                               class="category-chip @(selectedParentCategory == parent.Id ? "active" : "")">

                                @parent.Name

                            </a>

                            @if (selectedParentCategory == parent.Id)
                            {
                                var childCategories = categories
                                .Where(x => x.ParentCategoryId == parent.Id)
                                .OrderBy(x => x.Id)
                                .ToList();

                                foreach (var child in childCategories)
                                {
                                    <a asp-action="Index"
                                       asp-route-parentCategoryId="@parent.Id"
                                       asp-route-childCategoryId="@child.Id"
                                       asp-route-minPrice="@ViewBag.MinPrice"
                                       asp-route-maxPrice="@ViewBag.MaxPrice"
                                       asp-route-sort="@ViewBag.Sort"
                                       class="category-chip subcategory-chip @(selectedChildCategory == child.Id ? "active" : "")">

                                        @child.Name

                                    </a>
                                }
                            }
                        }

                    </div>
                </div>
                <div class="catalog-toolbar">

                    <a asp-action="Index"
                       class="reset-filters-btn">
                        Сбросить фильтры
                    </a>
                    <div class="catalog-count-chip">
                        Найдено товаров: @ViewBag.TotalProducts
                    </div>

                </div>
            </div>
        </div>

        <div class="catalog-content">

            <div class="catalog-sorting">

                <div class="catalog-categories">

                    <a asp-action="Index"
                       asp-route-parentCategoryId="@ViewBag.SelectedParentCategory"
                       asp-route-childCategoryId="@ViewBag.SelectedChildCategory"
                       asp-route-minPrice="@ViewBag.MinPrice"
                       asp-route-maxPrice="@ViewBag.MaxPrice"
                       class="sort-chip">
                        Популярные
                    </a>

                    <a asp-action="Index"
                       asp-route-parentCategoryId="@ViewBag.SelectedParentCategory"
                       asp-route-childCategoryId="@ViewBag.SelectedChildCategory"
                       asp-route-minPrice="@ViewBag.MinPrice"
                       asp-route-maxPrice="@ViewBag.MaxPrice"
                       asp-route-sort="new"
                       class="sort-chip @(ViewBag.Sort == "new" ? "active" : "")">
                        Новинки
                    </a>

                    <a asp-action="Index"
                       asp-route-parentCategoryId="@ViewBag.SelectedParentCategory"
                       asp-route-childCategoryId="@ViewBag.SelectedChildCategory"
                       asp-route-minPrice="@ViewBag.MinPrice"
                       asp-route-maxPrice="@ViewBag.MaxPrice"
                       asp-route-sort="cheap"
                       class="sort-chip @(ViewBag.Sort == "cheap" ? "active" : "")">
                        Сначала дешевле
                    </a>

                    <a asp-action="Index"
                       asp-route-parentCategoryId="@ViewBag.SelectedParentCategory"
                       asp-route-childCategoryId="@ViewBag.SelectedChildCategory"
                       asp-route-minPrice="@ViewBag.MinPrice"
                       asp-route-maxPrice="@ViewBag.MaxPrice"
                       asp-route-sort="expensive"
                       class="sort-chip @(ViewBag.Sort == "expensive" ? "active" : "")">
                        Сначала дороже
                    </a>

                    <a asp-action="Index"
                       asp-route-parentCategoryId="@ViewBag.SelectedParentCategory"
                       asp-route-childCategoryId="@ViewBag.SelectedChildCategory"
                       asp-route-minPrice="@ViewBag.MinPrice"
                       asp-route-maxPrice="@ViewBag.MaxPrice"
                       asp-route-sort="discount"
                       class="sort-chip @(ViewBag.Sort == "discount" ? "active" : "")">
                        По размеру скидки
                    </a>

                </div>
            </div>


                @if (!Model.Any())
                {
                    <div class="alert alert-warning text-center">
                        Товары не найдены
                    </div>
                }
                else
                {
                    <div class="row g-4">

                        @foreach (var product in Model)
                        {
                            <div class="col-md-6 col-lg-6 col-xl-4">

                                <div class="card product-card h-100 border-0">

                                    <a asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="product-link">

                                        <div class="product-image position-relative">

                                            <img src="@(string.IsNullOrEmpty(product.Picture)
                                                                                                            ? "/images/no-image.jpg"
                                                                                                            : product.Picture)"
                                         alt="@product.Name">

                                    @if (product.DiscountPercentage > 0)
                                            {
                                                <span class="discount-badge">
                                                    -@product.DiscountPercentage%
                                                </span>
                                            }

                                        </div>

                                    </a>

                                    <div class="card-body d-flex flex-column p-3">

                                        <a asp-action="Details"
                                           asp-route-id="@product.Id"
                                           class="product-name-link">

                                            <h5 class="card-title">
                                                @product.Name
                                            </h5>

                                        </a>

                                        <div class="mt-auto">

                                            <div class="text-center mb-4">

                                                <div class="price-block mx-auto">

                                                    @if (product.DiscountPercentage > 0)
                                                    {
                                                        decimal discountedPrice =
                                                        product.Price.GetValueOrDefault() *
                                                        (100 - product.DiscountPercentage.GetValueOrDefault()) / 100m;

                                                        <div class="old-price">
                                                            @product.Price?.ToString("N0") ₽
                                                        </div>

                                                        <div class="current-price discount-price">
                                                            @discountedPrice.ToString("N0") ₽
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="old-price invisible">
                                                            0 ₽
                                                        </div>

                                                        <div class="current-price">
                                                            @product.Price?.ToString("N0") ₽
                                                        </div>
                                                    }

                                                </div>

                                            </div>

                                            @if (product.StockQuantity > 0)
                                            {
                                                <form class="add-to-cart-form">

                                                    <input type="hidden"
                                                           name="productId"
                                                           value="@product.Id" />

                                                    <button type="submit"
                                                            class="btn btn-success w-100">

                                                        В корзину

                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <button class="btn btn-secondary w-100" disabled>
                                                    Нет в наличии
                                                </button>
                                            }

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
            @if ((int)ViewBag.TotalPages > 1)
            {
                <div class="catalog-pagination">

                    @if ((int)ViewBag.CurrentPage > 1)
                    {
                        <a asp-action="Index"
                           asp-route-page="@((int)ViewBag.CurrentPage - 1)"
                           asp-route-parentCategoryId="@ViewBag.SelectedParentCategory"
                           asp-route-childCategoryId="@ViewBag.SelectedChildCategory"
                           asp-route-minPrice="@ViewBag.MinPrice"
                           asp-route-maxPrice="@ViewBag.MaxPrice"
                           asp-route-sort="@ViewBag.Sort"
                           class="page-btn">
                            ←
                        </a>
                    }

                    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                    {
                        <a asp-action="Index"
                           asp-route-page="@i"
                           asp-route-parentCategoryId="@ViewBag.SelectedParentCategory"
                           asp-route-childCategoryId="@ViewBag.SelectedChildCategory"
                           asp-route-minPrice="@ViewBag.MinPrice"
                           asp-route-maxPrice="@ViewBag.MaxPrice"
                           asp-route-sort="@ViewBag.Sort"
                           class="page-btn @(i == (int)ViewBag.CurrentPage ? "active" : "")">

                            @i

                        </a>
                    }

                    @if ((int)ViewBag.CurrentPage < (int)ViewBag.TotalPages)
                    {
                        <a asp-action="Index"
                           asp-route-page="@((int)ViewBag.CurrentPage + 1)"
                           asp-route-parentCategoryId="@ViewBag.SelectedParentCategory"
                           asp-route-childCategoryId="@ViewBag.SelectedChildCategory"
                           asp-route-minPrice="@ViewBag.MinPrice"
                           asp-route-maxPrice="@ViewBag.MaxPrice"
                           asp-route-sort="@ViewBag.Sort"
                           class="page-btn">
                            →
                        </a>
                    }

                </div>
            }

        </div>
    </div>
</div>
<script>

    document.querySelectorAll('.add-to-cart-form')
    .forEach(form => {

        form.addEventListener('submit', async function (e) {

            e.preventDefault();

            const productId =
                this.querySelector('[name="productId"]').value;

            const response = await fetch('/Cart/Add', {

                method: 'POST',

                headers: {
                    'Content-Type':
                    'application/x-www-form-urlencoded'
                },

                body:
                    `productId=${productId}`
            });

            const result =
                await response.json();

            if (result.success) {

                document.getElementById('cart-count')
                    .textContent = result.count;

                toastr.success(
                    'Товар добавлен в корзину'
                );
            }
                else
                {
                toastr.warning(
                result.message
                );
                }
        });
    });

</script>
<script>

    function scrollCategories(id, amount)
    {
        document
            .getElementById(id)
            .scrollBy({
                left: amount,
                behavior: 'smooth'
            });
    }

</script>
<script>
    function toggleCategories() {

        const block =
            document.getElementById('categoriesBlock');

        block.classList.toggle('collapsed');
    }
        function togglePrice() {

        const block =
            document.getElementById('priceBlock');

        block.classList.toggle('collapsed');
    }
</script>
<script>

    const minSlider =
        document.getElementById('minPrice');

    const maxSlider =
        document.getElementById('maxPrice');

    const minText =
        document.getElementById('minPriceText');

    const maxText =
        document.getElementById('maxPriceText');
        const sliderRange =
    document.getElementById('sliderRange');

        function updatePriceSlider(e) {

        let min = parseInt(minSlider.value);
        let max = parseInt(maxSlider.value);

        if (e && e.target === minSlider && min >= max) {

            min = max - 100;
            minSlider.value = min;
        }

        if (e && e.target === maxSlider && max <= min) {

            max = min + 100;
            maxSlider.value = max;
        }

        minText.value = min;

        maxText.value =
            max >= 10000
            ? '10000+'
            : max;

        updateRangeBackground();
    }

        minSlider.addEventListener('input', function (e) {
        updatePriceSlider(e);
    });

    maxSlider.addEventListener('input', function (e) {
        updatePriceSlider(e);
    });
    updateRangeBackground();
    updatePriceSlider();
        function updateRangeBackground() {

        const min = parseInt(minSlider.value);
        const max = parseInt(maxSlider.value);

        const left = (min / 10000) * 100;
        const right = (max / 10000) * 100;

        sliderRange.style.left = left + "%";
        sliderRange.style.width = (right - left) + "%";
    }

    minText.addEventListener('change', function () {

        let value = parseInt(this.value) || 0;

        if (value < 0)
            value = 0;

        if (value > 10000)
            value = 10000;

        minSlider.value = value;

        updatePriceSlider();
        updateRangeBackground();
    });

    maxText.addEventListener('change', function () {

        let value =
            parseInt(this.value.replace('+', '')) || 10000;

        if (value < 0)
            value = 0;

        if (value > 10000)
            value = 10000;

        maxSlider.value = value;

        updatePriceSlider();
        updateRangeBackground();
    });

    minSlider.addEventListener('input', updateRangeBackground);
    maxSlider.addEventListener('input', updateRangeBackground);

    updateRangeBackground();
</script>
