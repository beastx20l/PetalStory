            box-shadow: 0 10px 30px rgba(0,0,0,.15);
        }

    .product-image {
        height: 320px;
        overflow: hidden;
        background: #fff;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .4s ease;
        }

    .product-card:hover img {
        transform: scale(1.05);
    }

    .discount-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 46px;
        height: 46px;
        border-radius: 50%;
