<script>

    document.querySelectorAll('.add-to-cart-form')
    .forEach(form => {

        form.addEventListener('submit', async function (e) {

            e.preventDefault();

            const productId =
                this.querySelector('[name="productId"]').value;

            const response = await fetch('/Cart/Add', {

                method: 'POST',

                headers: {
                    'Content-Type':
                    'application/x-www-form-urlencoded'
                },

                body:
                    `productId=${productId}`
            });

            const result =
                await response.json();

            if (result.success) {

                document.getElementById('cart-count')
                    .textContent = result.count;

                toastr.success(
                    'Товар добавлен в корзину'
                );
            }
                else 
                {
                toastr.warning(
                result.message
                );
                }
        });
    });

</script>
