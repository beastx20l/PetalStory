        letter-spacing: 1.5px;
        text-transform: uppercase;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(255, 187, 183, .35);
    }

        .btn-success:hover {
            background: #ffaea9;
            border-color: #ffaea9;
            color: #111 !important;
            transform: translateY(-2px);
        }

    .badge {
        border-radius: 8px;
    }

    .price-block {
        height: 34px;
    }

    .old-price {
        font-size: 16px;
        color: #999;
        text-decoration: line-through;
        line-height: 1.1;
    }

    .current-price {
        font-size: 28px;
        font-weight: 700;
        line-height: 1;
        color: #72D572;
    }

    .product-link,
    .product-name-link {
        text-decoration: none;
        color: inherit;
    }

    .card-body {
        padding-top: 8px !important;
        padding-bottom: 8px !important;
    }

    .catalog-title {
