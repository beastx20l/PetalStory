@model List<FlowerShop.Models.Product>

@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="container py-5">

    <div class="row mb-4">

        <div class="col-md-8">
            <h1 class="fw-bold">
                Каталог товаров
            </h1>
        </div>

        <div class="col-md-4">

            <form method="get">

                <div class="input-group">

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Поиск товаров..." />

                    <button type="submit"
                            class="btn btn-success">
                        Найти
                    </button>

                </div>

            </form>

        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            Товары не найдены
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">

                    <div class="card product-card h-100 border-0">

                        <a asp-action="Details"
                           asp-route-id="@product.Id"
                           class="product-link">

                            <div class="product-image position-relative">

                                <img src="@(string.IsNullOrEmpty(product.Picture)
                                                           ? "/images/no-image.jpg"
                                                           : product.Picture)"
                             alt="@product.Name">

                        @if (product.DiscountPercentage > 0)
                                {
                                    <span class="discount-badge">
                                        -@product.DiscountPercentage%
                                    </span>
                                }

                            </div>

                        </a>

                        <div class="card-body d-flex flex-column p-3">

                            <a asp-action="Details"
                               asp-route-id="@product.Id"
                               class="product-name-link">

                                <h5 class="card-title">
                                    @product.Name
                                </h5>

                            </a>

                            <div class="mt-auto">

                                <div class="text-center mb-3">

                                    <div class="price-block mx-auto">

                                        @if (product.DiscountPercentage > 0)
                                        {
                                            decimal discountedPrice =
                                            product.Price.GetValueOrDefault() *
                                            (100 - product.DiscountPercentage.GetValueOrDefault()) / 100m;

                                            <div class="old-price">
                                                @product.Price?.ToString("N0") ₽
                                            </div>

                                            <div class="current-price discount-price">
                                                @discountedPrice.ToString("N0") ₽
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="old-price invisible">
                                                0 ₽
                                            </div>

                                            <div class="current-price">
                                                @product.Price?.ToString("N0") ₽
                                            </div>
                                        }

                                    </div>

                                </div>

                                @if (product.StockQuantity > 0)
                                {
                                    <button class="btn btn-success w-100">
                                        В корзину
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100" disabled>
                                        Нет в наличии
                                    </button>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
<style>
    .product-card {
        border-radius: 16px;
        overflow: hidden;
        transition: all .25s ease;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 30px rgba(0,0,0,.15);
        }

    .product-image {
        height: 320px;
        overflow: hidden;
        background: #fff;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .4s ease;
        }

    .product-card:hover img {
        transform: scale(1.05);
    }

    .discount-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #dc3545;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 15px;
        box-shadow: 0 4px 12px rgba(0,0,0,.2);
    }

    .card-title {
        font-weight: 600;
        font-size: 16px;
        line-height: 1.3;
        height: 42px;
        overflow: hidden;
    }

    .btn-success {
        border-radius: 10px;
    }

    .badge {
        border-radius: 8px;
    }

    .price-block {
        height: 40px;
    }

    .old-price {
        font-size: 14px;
        color: #999;
        text-decoration: line-through;
        line-height: 1.1;
    }

    .current-price {
        font-size: 34px;
        font-weight: 700;
        line-height: 1;
    }

    .discount-price {
        color: #2e7d32;
    }

    .product-link,
    .product-name-link {
        text-decoration: none;
        color: inherit;
    }

    .card-body {
        padding-top: 12px !important;
        padding-bottom: 12px !important;
    }
</style>