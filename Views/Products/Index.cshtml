        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 15px;
        box-shadow: 0 4px 12px rgba(0,0,0,.2);
    }

    .card-title {
        font-weight: 600;
        font-size: 18px;
        line-height: 1.3;
        height: 48px;
        overflow: hidden;
        text-align: center;
        margin-bottom: 8px;
    }

        .btn-success
    {
        background: #ffbbb7;
        border-color: #ffbbb7;
        color: #222 !important;
        font-family: "Trebuchet MS", sans-serif;
        font-size: 14px;
