<script>

    let priceFilterTimer;

    function applyPriceFilter() {

        clearTimeout(priceFilterTimer);

        priceFilterTimer = setTimeout(() => {

            const min =
                document.getElementById('minPrice').value;

            const max =
                document.getElementById('maxPrice').value;

            const url =
                new URL(window.location.href);

            url.searchParams.set('minPrice', min);
            url.searchParams.set('maxPrice', max);

            window.location.href = url;

        }, 700);
    }

    minSlider.addEventListener('change', applyPriceFilter);

    maxSlider.addEventListener('change', applyPriceFilter);

</script>