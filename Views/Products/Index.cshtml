@model List<FlowerShop.Models.Product>

@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="container py-5">

    <div class="row mb-4">

        <div class="col-md-8">
            <h1 class="fw-bold">
                Каталог товаров
            </h1>
        </div>

        <div class="col-md-4">

            <form method="get">

                <div class="input-group">

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Поиск товаров..." />

                    <button type="submit"
                            class="btn btn-success">
                        Найти
                    </button>

                </div>

            </form>

        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            Товары не найдены
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">

                    <div class="card h-100 shadow-sm border-0 overflow-hidden">

                        <div class="product-image">

                            <img src="@(string.IsNullOrEmpty(product.Picture)
                                              ? "/images/no-image.jpg"
                                              : product.Picture)"
                         alt="@product.Name">

                        </div>

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                @product.Name
                            </h5>

                            <p class="text-muted small">
                                @(product.Category?.Name ?? "Без категории")
                            </p>

                            <div class="mt-auto">

                                <div class="d-flex justify-content-between align-items-center mb-3">

                            @if (product.DiscountPercentage > 0)
                                    {
                                        decimal discountedPrice =
                                        product.Price.GetValueOrDefault() *
                                        (100 - product.DiscountPercentage.GetValueOrDefault()) / 100m;

                                        <div>

                                            <div class="text-muted text-decoration-line-through">
                                                @product.Price?.ToString("N0") ₽
                                            </div>

                                            <div class="fs-4 fw-bold text-success">
                                                @discountedPrice.ToString("N0") ₽
                                            </div>

                                            <span class="badge bg-danger">
                                                -@product.DiscountPercentage.GetValueOrDefault()%
                                            </span>

                                        </div>
                                    }

                            @if (product.StockQuantity > 0)
                                    {
                                        <span class="badge bg-success">
                                            В наличии
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Нет в наличии
                                        </span>
                                    }

                                </div>

                                <a asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-success w-100">
                                    Подробнее
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
<style>

    .product-image {
        height: 320px;
        overflow: hidden;
        border-radius: 8px 8px 0 0;
        background: #fff;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            display: block;
        }

    .card {
        overflow: hidden;
    }

</style>