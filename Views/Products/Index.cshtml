@model List<FlowerShop.Models.Product>

@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="container py-5">

    <div class="text-center mb-4">

        <h1 class="catalog-title">
            Каталог цветов
        </h1>

        <p class="catalog-subtitle">
            Авторские букеты и цветочные композиции
        </p>

        @{
            var categories =
            ViewBag.Categories as List<FlowerShop.Models.Category>
            ?? new List<FlowerShop.Models.Category>();

            int? selectedParentCategory =
            ViewBag.SelectedParentCategory as int?;

            int? selectedChildCategory =
            ViewBag.SelectedChildCategory as int?;
        }

        @{
            int parentPage = (int)(ViewBag.ParentPage ?? 1);
            int parentPages = (int)(ViewBag.ParentPages ?? 1);
            bool showParentPaging = parentPages > 1;

            var visibleParents = categories
            .Where(x => x.ParentCategoryId == null)
            .OrderBy(x => x.Id)
            .Skip((parentPage - 1) * 7)
            .Take(7)
            .ToList();
        }
        <div class="filter-title-chip">
            Категории
        </div>
        <div class="categories-wrapper">

            @if (showParentPaging && parentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-parentPage="@(parentPage - 1)"
                   asp-route-parentCategoryId="@selectedParentCategory"
                   asp-route-childCategoryId="@selectedChildCategory"
                   class="scroll-btn">

                    &#10094;

                </a>
            }

            <div class="catalog-categories">

                <a asp-action="Index"
                   class="category-chip @(selectedParentCategory == null && selectedChildCategory == null ? "active" : "")">

                    Все товары

                </a>

                @foreach (var parent in visibleParents)
                {
                    <a asp-action="Index"
                       asp-route-parentCategoryId="@parent.Id"
                       class="category-chip @(selectedParentCategory == parent.Id ? "active" : "")">

                        @parent.Name

                    </a>
                }

            </div>

            @if (showParentPaging && parentPage < parentPages)
            {
                <a asp-action="Index"
                   asp-route-parentPage="@(parentPage + 1)"
                   asp-route-parentCategoryId="@selectedParentCategory"
                   asp-route-childCategoryId="@selectedChildCategory"
                   class="scroll-btn">

                    &#10095;

                </a>
            }

        </div>

        @if (selectedParentCategory.HasValue)
        {
            var childCategories = categories
            .Where(x => x.ParentCategoryId == selectedParentCategory)
            .OrderBy(x => x.Id)
            .ToList();
            int childPage =
            (int)(ViewBag.ChildPage ?? 1);

            int childPages =
            (int)(ViewBag.ChildPages ?? 1);
            bool showChildPaging = childPages > 1;

            var visibleChildren = childCategories
            .Skip((childPage - 1) * 7)
            .Take(7)
            .ToList();
            if (childCategories.Any())
            {
                <div class="filter-title-chip">
                    Подкатегории
                </div>
            <div class="categories-wrapper">
                    @if (showChildPaging && childPage > 1)
                    {
                        <a asp-action="Index"
                           asp-route-parentCategoryId="@selectedParentCategory"
                           asp-route-childPage="@(childPage - 1)"
                           class="scroll-btn">

                            ❮

                        </a>
                    }
                <div class="catalog-subcategories"
                     id="subCategoriesRow">

                    <a asp-action="Index"
                       asp-route-parentCategoryId="@selectedParentCategory"
                       class="category-chip @(selectedChildCategory == null ? "active" : "")">

                        Все

                    </a>

                        @foreach (var child in visibleChildren)
                    {
                        <a asp-action="Index"
                           asp-route-parentCategoryId="@selectedParentCategory"
                           asp-route-childCategoryId="@child.Id"
                           class="category-chip subcategory-chip @(selectedChildCategory == child.Id ? "active" : "")">

                            @child.Name

                        </a>
                    }

                </div>
                    @if (showChildPaging && childPage < childPages)
                    {
                        <a asp-action="Index"
                           asp-route-parentCategoryId="@selectedParentCategory"
                           asp-route-childPage="@(childPage + 1)"
                           class="scroll-btn">

                            ❯

                        </a>
                    }
            </div>
            }
        }

    </div>
    <div class="sorting-section">

        <div class="filter-title-chip">
            Сортировка
        </div>

        <div class="catalog-categories">

            <a href="#"
               class="category-chip active">
                Популярные
            </a>

            <a href="#"
               class="category-chip">
                Новинки
            </a>

            <a href="#"
               class="category-chip">
                Сначала дешевле
            </a>

            <a href="#"
               class="category-chip">
                Сначала дороже
            </a>

            <a href="#"
               class="category-chip">
                Со скидкой
            </a>

        </div>

    </div>
    <div class="reset-filters-wrapper">

        <a asp-action="Index"
           class="reset-filters-btn">

            Сбросить фильтры

        </a>

    </div>
    <div class="catalog-count-bottom">
        <span class="catalog-count-chip">
            Найдено товаров: @Model.Count
        </span>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            Товары не найдены
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">

                    <div class="card product-card h-100 border-0">

                        <a asp-action="Details"
                           asp-route-id="@product.Id"
                           class="product-link">

                            <div class="product-image position-relative">

                                <img src="@(string.IsNullOrEmpty(product.Picture)
                                                           ? "/images/no-image.jpg"
                                                           : product.Picture)"
                             alt="@product.Name">

                        @if (product.DiscountPercentage > 0)
                                {
                                    <span class="discount-badge">
                                        -@product.DiscountPercentage%
                                    </span>
                                }

                            </div>

                        </a>

                        <div class="card-body d-flex flex-column p-3">

                            <a asp-action="Details"
                               asp-route-id="@product.Id"
                               class="product-name-link">

                                <h5 class="card-title">
                                    @product.Name
                                </h5>

                            </a>

                            <div class="mt-auto">

                                <div class="text-center mb-4">

                                    <div class="price-block mx-auto">

                                        @if (product.DiscountPercentage > 0)
                                        {
                                            decimal discountedPrice =
                                            product.Price.GetValueOrDefault() *
                                            (100 - product.DiscountPercentage.GetValueOrDefault()) / 100m;

                                            <div class="old-price">
                                                @product.Price?.ToString("N0") ₽
                                            </div>

                                            <div class="current-price discount-price">
                                                @discountedPrice.ToString("N0") ₽
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="old-price invisible">
                                                0 ₽
                                            </div>

                                            <div class="current-price">
                                                @product.Price?.ToString("N0") ₽
                                            </div>
                                        }

                                    </div>

                                </div>

                                @if (product.StockQuantity > 0)
                                {
                                    <form class="add-to-cart-form">

                                        <input type="hidden"
                                               name="productId"
                                               value="@product.Id" />

                                        <button type="submit"
                                                class="btn btn-success w-100">

                                            В корзину

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100" disabled>
                                        Нет в наличии
                                    </button>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
<script>

    document.querySelectorAll('.add-to-cart-form')
    .forEach(form => {

        form.addEventListener('submit', async function (e) {

            e.preventDefault();

            const productId =
                this.querySelector('[name="productId"]').value;

            const response = await fetch('/Cart/Add', {

                method: 'POST',

                headers: {
                    'Content-Type':
                    'application/x-www-form-urlencoded'
                },

                body:
                    `productId=${productId}`
            });

            const result =
                await response.json();

            if (result.success) {

                document.getElementById('cart-count')
                    .textContent = result.count;

                toastr.success(
                    'Товар добавлен в корзину'
                );
            }
                else 
                {
                toastr.warning(
                result.message
                );
                }
        });
    });

</script>
<script>

    function scrollCategories(id, amount)
    {
        document
            .getElementById(id)
            .scrollBy({
                left: amount,
                behavior: 'smooth'
            });
    }

</script>
