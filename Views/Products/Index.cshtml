    .filter-title-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 22px;
        margin-top: 24px;
        margin-bottom: 16px;
        border-radius: 999px;
        background: #fff;
        color: #444;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: .5px;
        border: 1px solid #f0f0f0;
        box-shadow: 0 4px 14px rgba(0,0,0,.05);
        width: 180px;
    }

    .catalog-count-bottom {
        display: flex;
        justify-content: center;
        margin-top: 18px;
        margin-bottom: 40px;
    }

    .catalog-count-chip {
        display: inline-flex;
