@model FlowerShop.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-5">

    <div class="row">

        <div class="col-lg-6">

            <img src="@(string.IsNullOrEmpty(Model.Picture)
                                 ? "/images/no-image.jpg"
                                 : Model.Picture)"
                 class="img-fluid rounded shadow"
                 alt="@Model.Name">

        </div>

        <div class="col-lg-6">

            <h1 class="fw-bold mb-3">
                @Model.Name
            </h1>

            <p class="text-muted">
                @(Model.Category?.Name ?? "Без категории")
            </p>

            <h2 class="text-success mb-4">
                @Model.Price ₽
            </h2>

            @if (Model.StockQuantity > 0)
            {
                <span class="badge bg-success mb-4">
                    В наличии
                </span>
            }
            else
            {
                <span class="badge bg-danger mb-4">
                    Нет в наличии
                </span>
            }

            <div class="mt-4">

                <h5>Описание</h5>

                <p>
                    @(string.IsNullOrWhiteSpace(Model.Description)
                                        ? "Описание отсутствует."
                                        : Model.Description)
                </p>

            </div>

            <div class="mt-4">

                <a href="/Products"
                   class="btn btn-outline-secondary">
                    Назад в каталог
                </a>

                <button class="btn btn-success ms-2">
                    Добавить в корзину
                </button>

            </div>

        </div>

    </div>

</div>