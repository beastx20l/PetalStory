@model FlowerShop.Models.ViewModels.EditProfileViewModel

<div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editProfileModalLabel">Редактирование профиля</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editProfileForm" asp-action="EditProfile" method="post">
                    <div class="mb-3">
                        <label class="form-label">Имя</label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Фамилия</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Телефон</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email (нельзя изменить)</label>
                        <input asp-for="Email" class="form-control" readonly />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-success" onclick="saveProfile()">Сохранить изменения</button>
            </div>
        </div>
    </div>
</div>

<script>
    function saveProfile() {
        var form = $('#editProfileForm');
        $.post(form.attr('action'), form.serialize(), function (data) {
            if (data.success) {
                $('#editProfileModal').modal('hide');
                location.reload(); // обновляем страницу
            } else {
                alert('Ошибка при сохранении');
            }
        });
    }
</script>