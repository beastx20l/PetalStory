@using FlowerShop.Models
@inject ApplicationDbContext _context
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetalStory</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            background-color: #f8f9fa;
        }

        .content {
            flex: 1 0 auto;
            padding-top: 62px;
        }

        .footer {
            flex-shrink: 0;
        }

        .navbar-logo {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            font-size: 30px;
            font-weight: 700;
            color: #222 !important;
            text-decoration: none;
            letter-spacing: 1px;
        }

            .navbar-logo:hover {
                color: #222 !important;
                text-decoration: none;
            }

        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 99999;
            height: 60px;
            background: rgba(255,255,255,.95) !important;
            backdrop-filter: blur(12px);
        }

        .nav-link {
            font-weight: 500;
        }

        .card {
            transition: all .3s ease;
        }

            .card:hover {
                transform: translateY(-8px);
                box-shadow: 0 10px 25px rgba(0,0,0,.15) !important;
            }

        .btn-success {
            transition: all .3s ease;
        }

            .btn-success:hover {
                transform: translateY(-2px);
            }

        #cart-count {
            font-size: 11px;
            min-width: 18px;
        }

        .nav-pill {
            display: flex !important;
            align-items: center;
            gap: 8px;
            padding: 8px 14px !important;
            background: white;
            border-radius: 30px;
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
            transition: .25s;
        }

            .nav-pill:hover {
                background: #ffbbb7;
                transform: translateY(-2px);
            }

        .cart-badge {
            background: #ffbbb7;
            color: #222;
            padding: 3px 8px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            min-width: 22px;
            text-align: center;
        }
    </style>
</head>
<body>
    @{
        int cartCount = 0;

        if (User.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = User.FindFirst("UserId")?.Value;

            if (int.TryParse(userIdClaim, out int userId))
            {
                cartCount = _context.CartItems
                .Where(x => x.UserId == userId)
                .Sum(x => x.Quantity);
            }
        }
    }
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">

                <!-- LEFT -->
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Главная</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Products">Каталог</a>
                    </li>
                </ul>

                <!-- CENTER -->
                <a class="navbar-brand navbar-logo mx-auto"
                   href="/">
                    PetalStory
                </a>

                <!-- RIGHT MENU -->
                <ul class="navbar-nav ms-auto">

                    @if (!User.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Auth/Login">
                                <i class="fa fa-sign-in-alt"></i> Войти
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Auth/Register">
                                <i class="fa fa-user-plus"></i> Регистрация
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="nav-link nav-pill"
                               asp-area=""
                               asp-controller="Cart"
                               asp-action="Index">

                                <i class="fa-solid fa-cart-shopping"></i>

                                <span class="cart-badge"
                                      id="cart-count">

                                    @cartCount

                                </span>

                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle nav-pill d-flex align-items-center"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <i class="fa fa-user-circle me-1"></i>
                                @(User.Identity?.Name ?? "Пользователь")
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Account"
                                       asp-action="Profile">
                                        <i class="fa fa-user me-2"></i> Личный кабинет
                                    </a>
                                </li>

                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="Dashboard"
                                           asp-action="Index">
                                            <i class="fa fa-lock me-2"></i> Админ-панель
                                        </a>
                                    </li>
                                }

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <a class="dropdown-item text-danger" href="/Auth/Logout">
                                        <i class="fa fa-sign-out-alt me-2"></i> Выйти
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- CONTENT -->
    <div class="content">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="footer bg-dark text-light py-4 mt-auto">
        <div class="container text-center">
            <p class="mb-0">
                &copy; 2026 PetalStory — Магазин свежих цветов с доставкой
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Toastr -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" asp-append-version="true" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-bottom-right",
            "timeOut": "5500",
            "extendedTimeOut": "1800",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut",
            "showDuration": 300,
            "hideDuration": 500
        };
    </script>

    <!-- Показ уведомлений из TempData -->
    <script>
        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                    toastr.success('@Html.Raw(TempData["SuccessMessage"])');
                </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
                <text>
                    toastr.error('@Html.Raw(TempData["ErrorMessage"])');
                </text>
        }
    </script>
</body>
</html>