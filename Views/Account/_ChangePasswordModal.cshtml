@model FlowerShop.Models.ViewModels.ChangePasswordViewModel

<div class="modal fade"
     id="changePasswordModal"
     tabindex="-1">

    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Изменение пароля
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <form id="changePasswordForm"
                      asp-controller="Account"
                      asp-action="ChangePassword"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">
                            Текущий пароль
                        </label>

                        <input asp-for="CurrentPassword"
                               type="password"
                               class="form-control" />

                        <span asp-validation-for="CurrentPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Новый пароль
                        </label>

                        <input asp-for="NewPassword"
                               type="password"
                               class="form-control" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Повторите новый пароль
                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>
                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Отмена
                </button>

                <button type="button"
                        class="btn btn-success"
                        onclick="changePassword()">
                    Сохранить
                </button>

            </div>

        </div>
    </div>
</div>

<script>
    function changePassword() {

        $('.text-danger').text('');

        const form = $('#changePasswordForm');

        $.ajax({

            url: form.attr('action'),
            type: 'POST',
            data: form.serialize(),

            success: function (response) {

                if (response.success) {

                    toastr.success(response.message);

                    $('#changePasswordModal').modal('hide');

                    form[0].reset();

                    return;
                }

                if (response.errors) {

                    Object.keys(response.errors)
                        .forEach(function (key) {

                            $(`[data-valmsg-for="${key}"]`)
                                .text(response.errors[key]);
                        });

                    return;
                }
            },

            error: function () {

                toastr.error(
                    'Ошибка соединения с сервером'
                );
            }
        });
    }
</script>