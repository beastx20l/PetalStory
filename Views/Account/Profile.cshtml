@model FlowerShop.Models.User

@{
    ViewData["Title"] = "Личный кабинет";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-4">Личный кабинет</h2>
        </div>
    </div>

    <div class="row">
        <!-- Левая колонка - Информация о пользователе -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Мои данные</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Имя:</strong><br>
                        <span>@(Model.FirstName ?? "Не указано")</span>
                    </div>
                    <div class="mb-3">
                        <strong>Фамилия:</strong><br>
                        <span>@(Model.LastName ?? "Не указано")</span>
                    </div>
                    <div class="mb-3">
                        <strong>Email:</strong><br>
                        <span>@Model.Email</span>
                    </div>
                    <div class="mb-3">
                        <strong>Телефон:</strong><br>
                        <span>@(Model.Phone ?? "Не указан")</span>
                    </div>

                    <a asp-action="Edit" class="btn btn-primary w-100 mt-3">
                        <i class="fa fa-edit"></i> Редактировать профиль
                    </a>
                </div>
            </div>
        </div>

        <!-- Правая колонка - История заказов -->
        <div class="col-md-8">
            <h4 class="mb-3">История заказов</h4>

            @if (Model.Orders != null && Model.Orders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>№ Заказа</th>
                                <th>Дата</th>
                                <th>Сумма</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders.OrderByDescending(o => o.CreatedAt))
                            {
                                <tr>
                                    <td>#@order.Id</td>
                                    <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td><strong>@order.TotalAmount.ToString("C0")</strong></td>
                                    <td><span class="badge bg-primary">@order.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    У вас пока нет заказов.
                </div>
            }
        </div>
    </div>
</div>