@model FlowerShop.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Личный кабинет";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="profile-title">
                Личный кабинет
            </h1>
        </div>
    </div>

    <div class="row">
        <!-- Левая колонка - Мои данные -->
        <div class="col-md-4">
            <div class="profile-card h-100">
                <div class="profile-card-header">
                    <h5 class="mb-0">Мои данные</h5>
                </div>
                <div class="profile-body">

                    <div class="profile-user">
                        <div class="profile-avatar">
                            <i class="fa fa-user"></i>
                        </div>

                        <div>
                            <div class="profile-name">
                                @(Model.FirstName ?? "") @(Model.LastName ?? "")
                            </div>

                            <div class="profile-date">
                                С нами с @Model.CreatedAt.ToString("dd.MM.yyyy")
                            </div>
                        </div>
                    </div>

                    <div class="profile-info-item">
                        <span>Email</span>
                        <strong>@Model.Email</strong>
                    </div>

                    <div class="profile-info-item">
                        <span>Телефон</span>
                        <strong>@(Model.Phone ?? "Не указан")</strong>
                    </div>

                    <div class="profile-info-item">
                        <span>Имя</span>
                        <strong>@(Model.FirstName ?? "Не указано")</strong>
                    </div>

                    <div class="profile-info-item">
                        <span>Фамилия</span>
                        <strong>@(Model.LastName ?? "Не указано")</strong>
                    </div>

                    <button type="button"
                            class="btn btn-buy w-100 mt-4"
                            data-bs-toggle="modal"
                            data-bs-target="#editProfileModal">
                        <i class="fa fa-edit"></i>
                        Редактировать профиль
                    </button>

                    <button type="button"
                            class="btn btn-back w-100 mt-2"
                            data-bs-toggle="modal"
                            data-bs-target="#changePasswordModal">
                        <i class="fa fa-key"></i>
                        Изменить пароль
                    </button>

                </div>
            </div>
        </div>

        <!-- Правая колонка -->
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="section-title mb-0">
                    Сохранённые адреса доставки
                </h3>
                <button type="button"
                        class="btn btn-add-address"
                        data-bs-toggle="modal"
                        data-bs-target="#addAddressModal">
                    <i class="fa fa-plus"></i>
                    Добавить адрес
                </button>
            </div>

            @if (Model.Addresses != null && Model.Addresses.Any())
            {
                <div class="addresses-scroll">
                    <div class="row g-3 mx-0">
                    @foreach (var address in Model.Addresses.OrderByDescending(a => a.IsDefault))
                    {
                        <div class="col-12 mb-3">
                            <div class="profile-card">
                                <div class="address-card-body">

                                    <div class="d-flex justify-content-between align-items-start">

                                        <div class="flex-grow-1">

                                            <div class="address-main">
                                                @address.Address
                                            </div>

                                            @if (!string.IsNullOrEmpty(address.RecipientName))
                                            {
                                                <div class="address-info">
                                                    <span>Получатель</span>
                                                    <strong>@address.RecipientName</strong>
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(address.Phone))
                                            {
                                                <div class="address-info">
                                                    <span>Телефон</span>
                                                    <strong>@address.Phone</strong>
                                                </div>
                                            }

                                        </div>

                                        <div class="address-actions">

                                            @if (address.IsDefault)
                                            {
                                                <div class="address-default-badge">
                                                    Основной адрес
                                                </div>
                                            }
                                            else
                                            {
                                                <button onclick="setDefaultAddress(@address.Id)"
                                                        class="btn btn-default-address">
                                                    Сделать основным
                                                </button>
                                            }

                                            <button onclick="showDeleteConfirm(@address.Id)"
                                                    class="btn btn-outline-danger btn-sm">
                                                <i class="fa fa-trash"></i>
                                            </button>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">У вас пока нет сохранённых адресов доставки.</div>
            }

            <!-- История заказов -->
            <h3 class="section-title mt-5 mb-3">
                История заказов
            </h3>
            <div class="orders-scroll">
            @if (Model.Orders != null && Model.Orders.Any())
            {
                @foreach (var order in Model.Orders.OrderByDescending(o => o.CreatedAt))
                {
                        <div class="profile-card mb-3 order-clickable"
                             data-order-id="@order.Id">

                        <div class="order-card-body">

                            <div class="order-header">

                                <div>
                                    <div class="order-number">
                                        Заказ #@order.Id
                                    </div>

                                    <div class="order-date">
                                        @order.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                    </div>
                                </div>

                                <div class="order-status">
                                    @order.Status
                                </div>

                            </div>

                            <div class="order-footer">

                                <span>Сумма заказа</span>

                                <strong>
                                    @order.TotalAmount.ToString("N0") ₽
                                </strong>

                            </div>

                        </div>
                        
                    </div>
                        <div class="d-none order-data"
                             id="order-@order.Id">

                            <div class="order-details-section">
                                <div class="order-details-label">
                                    Получатель
                                </div>

                                <div class="order-details-value">
                                    @order.CustomerName
                                </div>
                            </div>

                            <div class="order-details-section">
                                <div class="order-details-label">
                                    Телефон
                                </div>

                                <div class="order-details-value">
                                    @order.Phone
                                </div>
                            </div>

                            <div class="order-details-section">
                                <div class="order-details-label">
                                    Адрес доставки
                                </div>

                                <div class="order-details-value">
                                    @order.DeliveryAddress
                                </div>
                            </div>

                            <div class="order-details-section">
                                <div class="order-details-label">
                                    Способ оплаты
                                </div>

                                <div class="order-details-value">
                                    @order.PaymentMethod
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(order.Comment))
                            {
                                <div class="order-details-section">

                                    <div class="order-details-label">
                                        Комментарий
                                    </div>

                                    <div class="order-comment">
                                        @order.Comment
                                    </div>

                                </div>
                            }

                            <div class="order-divider"></div>

                            <div class="order-products-title">
                                Состав заказа
                            </div>

                            @foreach (var item in order.OrderItems)
                            {
                                <div class="order-product-row">

                                    <div class="order-product-name">
                                        @item.ProductName × @item.Quantity
                                    </div>

                                    <div class="order-product-price">
                                        @((item.PriceAtPurchase * item.Quantity).ToString("N0")) ₽
                                    </div>

                                </div>
                            }

                            <div class="order-total-box">

                                <div class="order-total-title">
                                    Итого
                                </div>

                                <div class="order-total-price">
                                    @order.TotalAmount.ToString("N0") ₽
                                </div>

                            </div>

                        </div>
                }
            }
            else
            {
                <div class="profile-card">
                    <div class="order-empty">
                        У вас пока нет заказов
                    </div>
                </div>
            }
        </div>
    </div>
    </div>
</div>

<!-- ==================== Модальное окно добавления адреса ==================== -->
<div class="modal fade" id="addAddressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog profile-modal-dialog">
        <div class="modal-content profile-modal">
            <div class="modal-header profile-modal-header">
                <h5 class="modal-title">
                    <i class="fa fa-map-marker-alt"></i>
                    Добавить новый адрес
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body profile-modal-body">
                <form id="addAddressForm">
                    <div class="mb-3">
                        <label class="form-label">Адрес <span class="text-danger">*</span></label>
                        <input type="text" id="Address" class="form-control" required>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="IsForAnotherPerson">
                        <label class="form-check-label" for="IsForAnotherPerson">
                            Заказ другому человеку
                        </label>
                    </div>

                    <!-- Поля для другого человека -->
                    <div id="AnotherPersonFields" style="display: none;">
                        <div class="mb-3">
                            <label class="form-label">Имя получателя <span class="text-danger">*</span></label>
                            <input type="text" id="RecipientName" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Телефон получателя <span class="text-danger">*</span></label>
                            <input type="tel"
                                   id="RecipientPhone"
                                   class="form-control"
                                   maxlength="12">
                        </div>
                    </div>

                    @if (Model.Addresses == null || !Model.Addresses.Any())
                    {
                        <div class="alert alert-info mb-3">
                            Первый адрес будет автоматически назначен основным.
                        </div>
                    }
                    else
                    {
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="IsDefault">
                            <label class="form-check-label" for="IsDefault">
                                Сделать адресом по умолчанию
                            </label>
                        </div>
                    }
                </form>
            </div>
            <div class="modal-footer profile-modal-footer">

                <button type="button"
                        class="btn btn-cancel-modal"
                        data-bs-dismiss="modal">
                    Отмена
                </button>

                <button type="button"
                        class="btn btn-save-address"
                        id="btnSaveAddress">
                    <i class="fa fa-plus"></i>
                    Добавить адрес
                </button>

            </div>
        </div>
    </div>
</div>

<!-- Модальное подтверждение удаления -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-nowrap">
                    Подтверждение удаления
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="fa fa-trash text-danger mb-3" style="font-size: 42px;"></i>

                <p class="fs-5 mb-0">
                    Вы действительно хотите удалить этот адрес?
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Удалить</button>
            </div>
        </div>
    </div>
</div>
