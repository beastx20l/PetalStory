@model FlowerShop.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Личный кабинет";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-4">Личный кабинет</h2>
        </div>
    </div>

    <div class="row">
        <!-- Левая колонка - Мои данные -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Мои данные</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Имя:</strong><br>
                        <span>@(Model.FirstName ?? "Не указано")</span>
                    </div>
                    <div class="mb-3">
                        <strong>Фамилия:</strong><br>
                        <span>@(Model.LastName ?? "Не указано")</span>
                    </div>
                    <div class="mb-3">
                        <strong>Email:</strong><br>
                        <span>@Model.Email</span>
                    </div>
                    <div class="mb-3">
                        <strong>Телефон:</strong><br>
                        <span>@(Model.Phone ?? "Не указан")</span>
                    </div>
                    <div class="mb-3">
                        <strong>Дата регистрации:</strong><br>
                        <span>@Model.CreatedAt.ToString("dd MMMM yyyy")</span>
                    </div>

                    <button type="button" class="btn btn-primary w-100 mt-3" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                        <i class="fa fa-edit"></i> Редактировать профиль
                    </button>
                    <button type="button" class="btn btn-outline-primary w-100 mt-2" onclick="alert('Функция изменения пароля в разработке')">
                        <i class="fa fa-key"></i> Изменить пароль
                    </button>
                </div>
            </div>
        </div>

        <!-- Правая колонка -->
        <div class="col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Сохранённые адреса доставки</h4>
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                    <i class="fa fa-plus"></i> Добавить адрес
                </button>
            </div>

            @if (Model.Addresses != null && Model.Addresses.Any())
            {
                <div class="row">
                    @foreach (var address in Model.Addresses.OrderByDescending(a => a.IsDefault))
                    {
                        <div class="col-12 mb-3">
                            <div class="card shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <p class="mb-2"><strong>📍 Адрес:</strong> @address.Address</p>
                                            @if (!string.IsNullOrEmpty(address.RecipientName))
                                            {
                                                <p class="mb-1"><strong>Получатель:</strong> @address.RecipientName</p>
                                            }
                                            @if (!string.IsNullOrEmpty(address.Phone))
                                            {
                                                <p class="mb-1"><strong>Телефон:</strong> @address.Phone</p>
                                            }
                                        </div>

                                        <div class="text-end">
                                            @if (address.IsDefault)
                                            {
                                                <span class="badge bg-success mb-2">Основной адрес</span>
                                            }
                                            else
                                            {
                                                <button onclick="setDefaultAddress(@address.Id)"
                                                        class="btn btn-outline-primary btn-sm mb-2">
                                                    Сделать основным
                                                </button>
                                            }
                                            <button onclick="showDeleteConfirm(@address.Id)"
                                                    class="btn btn-outline-danger btn-sm">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">У вас пока нет сохранённых адресов доставки.</div>
            }

            <!-- История заказов -->
            <h4 class="mb-3 mt-5">История заказов</h4>
            @if (Model.Orders != null && Model.Orders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>№ Заказа</th>
                                <th>Дата</th>
                                <th>Сумма</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Orders.OrderByDescending(o => o.CreatedAt))
                            {
                                <tr>
                                    <td><strong>#@order.Id</strong></td>
                                    <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td><strong>@order.TotalAmount.ToString("N0") ₽</strong></td>
                                    <td><span class="badge bg-primary">@order.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    У вас пока нет заказов.
                </div>
            }
        </div>
    </div>
</div>

<!-- ==================== Модальное окно добавления адреса ==================== -->
<div class="modal fade" id="addAddressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Добавить новый адрес</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addAddressForm">
                    <div class="mb-3">
                        <label class="form-label">Адрес <span class="text-danger">*</span></label>
                        <input type="text" id="Address" class="form-control" required>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="IsForAnotherPerson">
                        <label class="form-check-label" for="IsForAnotherPerson">
                            Заказ другому человеку
                        </label>
                    </div>

                    <!-- Поля для другого человека -->
                    <div id="AnotherPersonFields" style="display: none;">
                        <div class="mb-3">
                            <label class="form-label">Имя получателя <span class="text-danger">*</span></label>
                            <input type="text" id="RecipientName" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Телефон получателя <span class="text-danger">*</span></label>
                            <input type="tel" id="RecipientPhone" class="form-control">
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="IsDefault" checked>
                        <label class="form-check-label" for="IsDefault">Сделать адресом по умолчанию</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-success" id="btnSaveAddress">Добавить адрес</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное подтверждение удаления -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Подтверждение удаления</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p>Вы действительно хотите удалить этот адрес?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Удалить</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // === Переключение полей "Заказ другому человеку" ===
            const isForAnotherCheckbox = document.getElementById('IsForAnotherPerson');
            const anotherPersonFields = document.getElementById('AnotherPersonFields');

            if (isForAnotherCheckbox && anotherPersonFields) {
                isForAnotherCheckbox.addEventListener('change', function () {
                    if (this.checked) {
                        anotherPersonFields.style.display = 'block';
                        document.getElementById('RecipientName').required = true;
                        document.getElementById('RecipientPhone').required = true;
                    } else {
                        anotherPersonFields.style.display = 'none';
                        document.getElementById('RecipientName').required = false;
                        document.getElementById('RecipientPhone').required = false;
                        document.getElementById('RecipientName').value = '';
                        document.getElementById('RecipientPhone').value = '';
                    }
                });
            }

            // === Сохранение адреса ===
            const saveButton = document.getElementById('btnSaveAddress');
            if (saveButton) {
                saveButton.addEventListener('click', function () {
                    const isForAnother = isForAnotherCheckbox ? isForAnotherCheckbox.checked : false;

                    const data = {
                        address: document.getElementById('Address').value.trim(),
                        recipientName: isForAnother ? document.getElementById('RecipientName').value.trim() : null,
                        phone: isForAnother ? document.getElementById('RecipientPhone').value.trim() : null,
                        isDefault: document.getElementById('IsDefault').checked,
                        isForAnotherPerson: isForAnother
                    };

                    if (!data.address) {
                        toastr.error("Пожалуйста, заполните поле 'Адрес'");
                        return;
                    }

                    if (isForAnother && (!data.recipientName || !data.phone)) {
                        toastr.error("При заказе другому человеку нужно заполнить имя и телефон получателя");
                        return;
                    }

                    fetch('/Account/AddAddress', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                        },
                        body: JSON.stringify(data)
                    })
                    .then(response => {
                        if (response.ok) {
                            toastr.success('Адрес успешно добавлен!');
                            $('#addAddressModal').modal('hide');
                            setTimeout(() => location.reload(), 800);
                        } else {
                            return response.text().then(text => {
                                toastr.error(text || 'Не удалось добавить адрес');
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        toastr.error('Ошибка соединения с сервером');
                    });
                });
            } else {
                console.warn("Кнопка #btnSaveAddress не найдена!");
            }

            // === Удаление и установка основным (оставляем как было) ===
            window.deleteAddress = function (id) {
                if (confirm("Удалить этот адрес?")) {
                    fetch(`/Account/DeleteAddress/${id}`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value }
                    }).then(() => location.reload());
                }
            };

            window.setDefaultAddress = function (id) {
                if (confirm("Сделать этот адрес основным?")) {
                    fetch(`/Account/SetDefaultAddress/${id}`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value }
                    }).then(() => location.reload());
                }
            };
        });
    </script>
}