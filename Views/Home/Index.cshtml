@model List<FlowerShop.Models.Product>
@{
    ViewData["Title"] = "Главная";
}

<!-- Баннер -->
<section class="hero-section py-5 mb-5">

    <div class="container py-5 text-center">

        <div class="hero-badge">
            PetalStory
        </div>

        <h1 class="hero-title mt-4">
            Свежие цветы
            <br>
            с доставкой
        </h1>

        <p class="hero-subtitle">
            Авторские букеты, быстрая доставка
            и только свежие цветы для ваших близких
        </p>

        <a href="/Products"
           class="btn checkout-btn mt-3">
            Перейти в каталог
        </a>

    </div>

</section>

<!-- Популярные букеты -->
<section class="py-5">
    <div class="container">

        <div class="d-flex justify-content-between align-items-end mb-4">
            <h2>Популярные товары</h2>
            <a href="/Products"
               style="color:#000000; text-decoration:none; font-weight:600;">
                Все товары →
            </a>
        </div>

        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-md-6 col-lg-3">

                    <div class="card product-card h-100 border-0">

                        <a asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@product.Id"
                           class="product-link">

                            <div class="product-image position-relative">

                                <img src="@(string.IsNullOrEmpty(product.Picture)
                                                                 ? "/images/no-image.jpg"
                                                                 : product.Picture)"
                                 alt="@product.Name">

                            @if (product.DiscountPercentage > 0)
                                {
                                    <span class="discount-badge">
                                        -@product.DiscountPercentage%
                                    </span>
                                }

                            </div>

                        </a>

                        <div class="card-body d-flex flex-column p-3">

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="product-name-link">

                                <h5 class="card-title">
                                    @product.Name
                                </h5>

                            </a>

                            <div class="mt-auto">

                                <div class="text-center mb-4">

                                    <div class="price-block mx-auto">

                                        @if (product.DiscountPercentage > 0)
                                        {
                                            decimal discountedPrice =
                                            product.Price.GetValueOrDefault() *
                                            (100 - product.DiscountPercentage.GetValueOrDefault()) / 100m;

                                            <div class="old-price">
                                                @product.Price?.ToString("N0") ₽
                                            </div>

                                            <div class="current-price discount-price">
                                                @discountedPrice.ToString("N0") ₽
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="old-price invisible">
                                                0 ₽
                                            </div>

                                            <div class="current-price">
                                                @product.Price?.ToString("N0") ₽
                                            </div>
                                        }

                                    </div>

                                </div>

                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-success w-100">

                                    Подробнее

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
</section>

<section class="bg-white py-5">
    <div class="container">

        <h2 class="text-center mb-5">
            Почему выбирают нас
        </h2>

        <div class="row text-center">

            <div class="col-md-3">
                <i class="fa-solid fa-seedling fa-3x text-success mb-3"></i>
                <h5>Свежие цветы</h5>
                <p class="text-muted">
                    Поставки каждый день
                </p>
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-truck fa-3x text-success mb-3"></i>
                <h5>Быстрая доставка</h5>
                <p class="text-muted">
                    В день оформления заказа
                </p>
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-gift fa-3x text-success mb-3"></i>
                <h5>Большой выбор</h5>
                <p class="text-muted">
                    Букеты на любой повод
                </p>
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-heart fa-3x text-success mb-3"></i>
                <h5>Любовь к делу</h5>
                <p class="text-muted">
                    Собираем каждый букет вручную
                </p>
            </div>

        </div>

    </div>
</section>
<section class="py-5">

    <div class="container">

        <h2 class="text-center mb-5">
            Контакты
        </h2>

        <div class="row g-4">

            <div class="col-md-3">
                <div class="info-card">

                    <div class="info-icon">
                        📍
                    </div>

                    <h5>Адрес</h5>

                    <p>
                        г. Воронеж
                        <br>
                        ул. Цветочная, д.15
                    </p>

                </div>
            </div>

            <div class="col-md-3">
                <div class="info-card">

                    <div class="info-icon">
                        📞
                    </div>

                    <h5>Телефон</h5>

                    <p>
                        +7 (999) 123-45-67
                    </p>

                </div>
            </div>

            <div class="col-md-3">
                <div class="info-card">

                    <div class="info-icon">
                        ✉️
                    </div>

                    <h5>Email</h5>

                    <p>
                        admin@petalstory.ru
                    </p>

                </div>
            </div>

            <div class="col-md-3">
                <div class="info-card">

                    <div class="info-icon">
                        🕒
                    </div>

                    <h5>Режим работы</h5>

                    <p>
                        Ежедневно
                        <br>
                        09:00–21:00
                    </p>

                </div>
            </div>

        </div>

    </div>

</section>
<style>

    .hero-section {
        background: linear-gradient( 135deg, #fff0f5, #ffe4ec );
        border-radius: 30px;
    }

    .hero-badge {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 999px;
        background: white;
        font-weight: 600;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }

    .hero-title {
        font-size: 64px;
        font-weight: 800;
        color: #212529;
        line-height: 1.1;
    }

    .hero-subtitle {
        font-size: 22px;
        color: #666;
        max-width: 700px;
        margin: 25px auto;
    }

    .checkout-btn {
        height: 58px;
        border-radius: 12px;
        background: #ffbbb7;
        border: 1px solid #ffbbb7;
        color: #222 !important;
        font-family: "Trebuchet MS", sans-serif;
        font-size: 16px;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        box-shadow: 0 4px 12px rgba(255,187,183,.35);
        transition: .25s;
        padding: 0 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .checkout-btn:hover {
            background: #ffaea9;
            border-color: #ffaea9;
            transform: translateY(-2px);
        }

    .card {
        border: 1px solid #eeeeee;
        border-radius: 18px;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
        transition: .25s;
    }

        .card:hover {
            transform: translateY(-4px);
            border-color: #f4a6b5;
            box-shadow: 0 10px 30px rgba(244,166,181,.25);
        }

    .info-card {
        height: 100%;
        text-align: center;
        background: white;
        border: 1px solid #eeeeee;
        border-radius: 18px;
        padding: 30px 20px;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
        transition: .25s;
    }

        .info-card:hover {
            transform: translateY(-4px);
            border-color: #f4a6b5;
            box-shadow: 0 10px 30px rgba(244,166,181,.25);
        }

    .info-icon {
        font-size: 40px;
        margin-bottom: 15px;
    }

    .fa-seedling,
    .fa-truck,
    .fa-gift,
    .fa-heart {
        color: #ffbbb7 !important;
    }
    /* Карточки товаров */

    .product-card {
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid #eeeeee;
        transition: all .25s ease;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }

        .product-card:hover {
            transform: translateY(-4px);
            border-color: #f4a6b5;
            box-shadow: 0 10px 30px rgba(244,166,181,.25);
        }

    .product-image {
        height: 240px;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: transform .4s ease;
        }

    .product-card:hover .product-image img {
        transform: scale(1.05);
    }

    .discount-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #dc3545;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 15px;
        box-shadow: 0 4px 12px rgba(0,0,0,.2);
    }

    .product-link,
    .product-name-link {
        text-decoration: none;
        color: inherit;
    }

        .product-name-link:hover {
            color: inherit;
        }

    .price-block {
        height: 34px;
    }

    .old-price {
        font-size: 16px;
        color: #999;
        text-decoration: line-through;
        line-height: 1.1;
    }

    .current-price {
        font-size: 28px;
        font-weight: 700;
        line-height: 1;
        color: #72D572;
    }

    .card-title {
        font-weight: 600;
        font-size: 16px;
        line-height: 1.3;
        height: 42px;
        overflow: hidden;
        text-align: center;
        margin-bottom: 8px;
    }

    .product-card .card-body {
        padding-top: 12px !important;
        padding-bottom: 12px !important;
    }

    .btn-success {
        background: #ffbbb7 !important;
        border-color: #ffbbb7 !important;
        color: #222 !important;
        font-family: "Trebuchet MS", sans-serif;
        font-size: 14px;
        font-weight: 400;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(255,187,183,.35);
    }

        .btn-success:hover {
            background: #ffaea9 !important;
            border-color: #ffaea9 !important;
            color: #111 !important;
            transform: translateY(-2px);
        }
</style>