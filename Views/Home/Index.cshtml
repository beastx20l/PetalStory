@{
    ViewData["Title"] = "Главная";
}

<!-- Баннер -->
<div class="bg-light py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold">Свежие цветы<br>с доставкой</h1>
                <p class="lead text-muted">Качественные букеты по честным ценам.<br>Доставляем в день заказа.</p>
                <a href="/Products" class="btn btn-success btn-lg">Перейти в каталог</a>
            </div>
            <div class="col-lg-6 text-center">
                <img src="https://images.unsplash.com/photo-1518895949257-7621c3c9c1b5"
                     class="img-fluid rounded shadow" style="max-height: 380px;" alt="Букет">
            </div>
        </div>
    </div>
</div>

<!-- Популярные букеты -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <h2>Популярные букеты</h2>
            <a href="/Products" class="text-success">Все товары →</a>
        </div>

        <div class="row">
            <p class="text-center text-muted py-5">Здесь скоро будут товары...</p>
        </div>
    </div>
</section>