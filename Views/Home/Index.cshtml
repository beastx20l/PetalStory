@model List<FlowerShop.Models.Product>
@{
    ViewData["Title"] = "Главная";
}

<!-- Баннер -->
<section class="py-5 mb-5 text-white"
         style="
         background:
         linear-gradient(
         rgba(0,0,0,.45),
         rgba(0,0,0,.45)),
         url('https://images.unsplash.com/photo-1490750967868-88aa4486c946');
         background-size: cover;
         background-position: center;">

    <div class="container py-5">

        <div class="row">

            <div class="col-lg-7">

                <h1 class="display-3 fw-bold mb-4">
                    Свежие цветы
                    с доставкой
                </h1>

                <p class="lead mb-4">
                    Красивые букеты для любого повода.
                    Быстрая доставка и только свежие цветы.
                </p>

                <a href="/Products"
                   class="btn btn-success btn-lg me-2">
                    Перейти в каталог
                </a>

            </div>

        </div>

    </div>

</section>

<section class="py-5 bg-white">
    <div class="container">

        <h2 class="text-center mb-5">
            Категории товаров
        </h2>

        <div class="row g-4">

            <div class="col-md-3">
                <a href="/Products" class="text-decoration-none">
                    <div class="card text-center shadow-sm h-100">
                        <div class="card-body">
                            <div class="fs-1">🌹</div>
                            <h5 class="mt-3">Розы</h5>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-3">
                <a href="/Products" class="text-decoration-none">
                    <div class="card text-center shadow-sm h-100">
                        <div class="card-body">
                            <div class="fs-1">🌷</div>
                            <h5 class="mt-3">Тюльпаны</h5>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-3">
                <a href="/Products" class="text-decoration-none">
                    <div class="card text-center shadow-sm h-100">
                        <div class="card-body">
                            <div class="fs-1">💐</div>
                            <h5 class="mt-3">Букеты</h5>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-3">
                <a href="/Products" class="text-decoration-none">
                    <div class="card text-center shadow-sm h-100">
                        <div class="card-body">
                            <div class="fs-1">🎁</div>
                            <h5 class="mt-3">Подарочные композиции</h5>
                        </div>
                    </div>
                </a>
            </div>

        </div>

    </div>
</section>
<section class="py-5">
    <div class="container">

        <h2 class="text-center mb-5">
            Отзывы клиентов
        </h2>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <div class="mb-3 text-warning fs-5">
                            ★★★★★
                        </div>

                        <p>
                            Заказывала букет на день рождения.
                            Цветы свежие, доставка вовремя.
                            Очень довольна!
                        </p>

                    </div>

                    <div class="card-footer bg-white">
                        <strong>Анна К.</strong>
                    </div>

                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <div class="mb-3 text-warning fs-5">
                            ★★★★★
                        </div>

                        <p>
                            Большой выбор букетов и приятные цены.
                            Буду заказывать ещё.
                        </p>

                    </div>

                    <div class="card-footer bg-white">
                        <strong>Дмитрий С.</strong>
                    </div>

                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <div class="mb-3 text-warning fs-5">
                            ★★★★★
                        </div>

                        <p>
                            Очень красивое оформление букета.
                            Получатель был в восторге.
                        </p>

                    </div>

                    <div class="card-footer bg-white">
                        <strong>Екатерина В.</strong>
                    </div>

                </div>
            </div>

        </div>

    </div>
</section>

<!-- Популярные букеты -->
<section class="py-5">
    <div class="container">

        <div class="d-flex justify-content-between align-items-end mb-4">
            <h2>Популярные товары</h2>
            <a href="/Products" class="text-success">
                Все товары →
            </a>
        </div>

        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-md-3">

                    <div class="card h-100 shadow-sm">

                        <img src="@(string.IsNullOrEmpty(product.Picture)
                                         ? "/images/no-image.jpg"
                                         : product.Picture)"
                         class="card-img-top"
                         style="height:250px; object-fit:cover;">

                        <div class="card-body">

                            <h5 class="card-title">
                                @product.Name
                            </h5>

                            <div class="d-flex justify-content-between align-items-center">

                                <span class="text-success fw-bold fs-4">
                                    @product.Price ₽
                                </span>

                            @if (product.StockQuantity > 0)
                                {
                                    <span class="badge bg-success">
                                        В наличии
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Нет в наличии
                                    </span>
                                }

                            </div>

                        </div>

                        <div class="card-footer bg-white border-0">

                            <a href="/Products/Details/@product.Id"
                               class="btn btn-outline-success w-100">
                                Подробнее
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
</section>

<section class="bg-white py-5">
    <div class="container">

        <h2 class="text-center mb-5">
            Почему выбирают нас
        </h2>

        <div class="row text-center">

            <div class="col-md-3">
                <i class="fa-solid fa-seedling fa-3x text-success mb-3"></i>
                <h5>Свежие цветы</h5>
                <p class="text-muted">
                    Поставки каждый день
                </p>
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-truck fa-3x text-success mb-3"></i>
                <h5>Быстрая доставка</h5>
                <p class="text-muted">
                    В день оформления заказа
                </p>
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-gift fa-3x text-success mb-3"></i>
                <h5>Большой выбор</h5>
                <p class="text-muted">
                    Букеты на любой повод
                </p>
            </div>

            <div class="col-md-3">
                <i class="fa-solid fa-heart fa-3x text-success mb-3"></i>
                <h5>Любовь к делу</h5>
                <p class="text-muted">
                    Собираем каждый букет вручную
                </p>
            </div>

        </div>

    </div>
</section>
<section class="bg-success text-white py-5">
    <div class="container">

        <h2 class="text-center mb-5">
            Контакты
        </h2>

        <div class="row text-center">

            <div class="col-md-3 mb-4">

                <i class="fa-solid fa-location-dot fa-3x mb-3"></i>

                <h5>Адрес</h5>

                <p class="mb-0">
                    г. Москва,<br>
                    ул. Цветочная, д. 15
                </p>

            </div>

            <div class="col-md-3 mb-4">

                <i class="fa-solid fa-phone fa-3x mb-3"></i>

                <h5>Телефон</h5>

                <p class="mb-0">
                    +7 (999) 123-45-67
                </p>

            </div>

            <div class="col-md-3 mb-4">

                <i class="fa-solid fa-envelope fa-3x mb-3"></i>

                <h5>Email</h5>

                <p class="mb-0">
                    info@flowershop.ru
                </p>

            </div>

            <div class="col-md-3 mb-4">

                <i class="fa-solid fa-clock fa-3x mb-3"></i>

                <h5>Режим работы</h5>

                <p class="mb-0">
                    Ежедневно<br>
                    09:00 – 21:00
                </p>

            </div>

        </div>

    </div>
</section>