@model FlowerShop.Models.ViewModels.LoginViewModel

<div class="container mt-5"
     style="max-width: 500px;">

    <div class="card login-card">

        <div class="card-body p-4">

            <h2 class="text-center mb-4 login-title">
                Вход в аккаунт
            </h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form method="post">

                <div class="mb-3">

                    <label>Email</label>

                    <input asp-for="Email"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label>Пароль</label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control" />

                </div>

                <button type="submit"
                        class="btn btn-login w-100">

                    Войти

                </button>

            </form>

            <div class="text-center mt-3">

                <a href="/Auth/Register"
                   class="login-link">
                    Зарегистрироваться
                </a>

            </div>

        </div>

    </div>

</div>
<style>
    .btn-login {
        height: 52px;
        border: none;
        border-radius: 12px;
        background: #ffbbb7;
        color: #222;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(255,187,183,.35);
        transition: .2s;
    }

        .btn-login:hover {
            background: #ffaea9;
            color: #111;
            transform: translateY(-2px);
        }

    .login-card {
        border: none;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
    }

    .login-title {
        font-size: 36px;
        font-weight: 700;
        color: #222;
    }

    .form-control {
        height: 50px;
        border-radius: 12px;
    }

    .login-link {
        color: #888;
        text-decoration: none;
        font-weight: 500;
    }

        .login-link:hover {
            color: #ff9f99;
        }
</style>