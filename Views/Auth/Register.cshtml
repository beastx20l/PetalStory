@model FlowerShop.Models.ViewModels.RegisterViewModel

<div class="container mt-5"
     style="max-width: 650px;">

    <div class="card register-card">

        <div class="card-body p-4">

            <h2 class="text-center mb-4 register-title">
                Создание аккаунта
            </h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form method="post">

                <!-- ИМЯ -->
                <div class="mb-3">

                    <label class="form-label">
                        Имя
                    </label>

                    <input asp-for="FirstName"
                           class="form-control" />

                    <span asp-validation-for="FirstName"
                          class="text-danger"></span>

                </div>

                <!-- ФАМИЛИЯ -->
                <div class="mb-3">

                    <label class="form-label">
                        Фамилия
                    </label>

                    <input asp-for="LastName"
                           class="form-control" />

                    <span asp-validation-for="LastName"
                          class="text-danger"></span>

                </div>

                <!-- ТЕЛЕФОН -->
                <div class="mb-3">

                    <label class="form-label">
                        Телефон
                    </label>

                    <input asp-for="Phone"
                           class="form-control"
                           maxlength="12"
                           pattern="\+7[0-9]{10}"
                           onfocus="
                           if(this.value === '')
                           this.value = '+7';
                           "
                           oninput="
                           this.value=this.value.replace(/[^0-9+]/g, '' );
                           if (!this.value.startsWith('+7')) {
                           this.value='+7' ;
                           }
                           if (this.value.length> 12) {
                    this.value =
                    this.value.slice(0, 12);
                    }
                    " />

                    <span asp-validation-for="Phone"
                          class="text-danger"></span>

                </div>

                <!-- EMAIL -->
                <div class="mb-3">

                    <label class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>

                </div>

                <!-- PASSWORD -->
                <div class="mb-3">

                    <label class="form-label">
                        Пароль
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control" />

                    <span asp-validation-for="Password"
                          class="text-danger"></span>

                </div>

                <!-- CONFIRM PASSWORD -->
                <div class="mb-4">

                    <label class="form-label">
                        Повторите пароль
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger"></span>

                </div>

                <button type="submit"
                        class="btn btn-register w-100">

                    Зарегистрироваться

                </button>

            </form>

            <div class="text-center mt-3">

                <a href="/Auth/Login"
                   class="register-link">
                    Уже есть аккаунт?
                </a>

            </div>

        </div>

    </div>

</div>
<style>

    .register-card {
        border: none;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
    }

    .register-title {
        font-size: 36px;
        font-weight: 700;
        color: #222;
    }

    .register-card .form-control {
        height: 50px;
        border-radius: 12px;
    }

    .register-card .form-label {
        font-weight: 600;
        color: #444;
    }

    .btn-register {
        height: 52px;
        border: none;
        border-radius: 12px;
        background: #ffbbb7;
        color: #222;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(255,187,183,.35);
        transition: .2s;
    }

        .btn-register:hover {
            background: #ffaea9;
            color: #111;
            transform: translateY(-2px);
        }

    .register-link {
        color: #888;
        text-decoration: none;
        font-weight: 500;
    }

        .register-link:hover {
            color: #ff9f99;
        }

</style>
@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}
