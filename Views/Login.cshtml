@model FlowerShop.Models.ViewModels.LoginViewModel

<div class="container mt-5" style="max-width: 400px;">

    <h2 class="mb-4">Вход</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <form method="post">

        <div class="mb-3">
            <label>Email</label>

            <input asp-for="Email"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Пароль</label>

            <input asp-for="Password"
                   type="password"
                   class="form-control" />
        </div>

        <button type="submit"
                class="btn btn-primary w-100">
            Войти
        </button>

    </form>

</div>
