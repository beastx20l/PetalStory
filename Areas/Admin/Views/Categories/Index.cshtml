@model IEnumerable<FlowerShop.Models.Category>
@{
    ViewData["Title"] = "Категории";
    var rootCategories = Model
        .Where(x => x.ParentCategoryId == null)
        .OrderBy(x => x.Id)
        .ToList();
}

<div class="container mt-4">
    <div class="admin-topbar mb-4">
        <div>
            <h1 class="admin-header">
                Категории товаров
            </h1>
            <p class="admin-subtitle">
                Управление структурой каталога PetalStory
            </p>
        </div>
        <a asp-action="Create" class="save-btn">
            + Добавить категорию
        </a>
    </div>
    <!-- === ФИЛЬТРЫ И ПОИСК ДЛЯ КАТЕГОРИЙ === -->
    <div class="filters-panel">
        <div class="search-box">
            <input type="text" id="searchInput" placeholder="Поиск по названию категории" autocomplete="off">
        </div>

        <div class="filter-group">
            <label>Товары</label>
            <select id="productsFilter">
                <option value="">Все</option>
                <option value="has">Есть товары</option>
                <option value="empty">Нет товаров</option>
            </select>
        </div>

        <div class="filter-group">
            <label>Сортировка</label>
            <select id="sortSelect">
                <option value="products-desc">Товаров (по убыванию)</option>
                <option value="products-asc">Товаров (по возрастанию)</option>
            </select>
        </div>
    </div>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="product-form-card text-center py-5">
            <p class="text-muted fs-5">Категории пока отсутствуют</p>
            <a asp-action="Create" class="save-btn mt-3">Создать первую категорию</a>
        </div>
    }
    else
    {
        @foreach (var root in rootCategories)
        {
            var totalProducts = root.Products.Count +
                Model.Where(x => x.ParentCategoryId == root.Id)
                     .Sum(x => x.Products.Count);

            <div class="product-form-card mb-4">
                <div class="category-header d-flex justify-content-between align-items-center p-3 border-bottom">
                    <div class="d-flex align-items-center gap-3 flex-grow-1" style="cursor:pointer;" onclick="toggleCategory(@root.Id)">
                        <div class="admin-icon-small">
                            <i class="fa fa-tags"></i>
                        </div>
                        <div>
                            <strong style="font-size:1.3rem;">@root.Name</strong>
                            <span class="badge bg-light text-dark ms-3">ID: @root.Id</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <div class="text-end me-3">
                            <span class="text-muted">Товаров:</span> 
                            <strong>@totalProducts</strong>
                        </div>
                        <div class="d-flex gap-2 action-area">
                            <a asp-action="Edit"
                               asp-route-id="@root.Id"
                               class="btn-edit btn-sm">
                                Изменить
                            </a>
                            <button type="button"
                                    class="btn-delete btn-sm"
                                    onclick="event.stopImmediatePropagation(); showDeleteCategory(@root.Id)">
                                Удалить
                            </button>
                        </div>
                        <span class="category-arrow" onclick="toggleCategory(@root.Id); event.stopImmediatePropagation();">
                            <i class="fa fa-chevron-down"></i>
                        </span>
                    </div>
                </div>

                <div id="category-@root.Id" class="collapse">
                    <div class="p-3">
                        @{
                            var children = Model
                                .Where(x => x.ParentCategoryId == root.Id)
                                .OrderBy(x => x.Id)
                                .ToList();
                        }
                        @if (children.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var child in children)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <i class="fa fa-folder text-muted"></i>
                                            <div>
                                                <strong>@child.Name</strong>
                                                <span class="badge bg-secondary ms-2">ID: @child.Id</span>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2 action-area">
                                            <span class="text-muted me-3">Товаров: <strong>@child.Products.Count</strong></span>
                                            <a asp-action="Edit"
                                               asp-route-id="@child.Id"
                                               class="btn-edit btn-sm">
                                                Изменить
                                            </a>
                                            <button type="button"
                                                    class="btn-delete btn-sm"
                                                    onclick="event.stopImmediatePropagation(); showDeleteCategory(@child.Id)">
                                                Удалить
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                Подкатегорий нет
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Модальное окно -->
<div class="modal fade" id="deleteCategoryModal" tabindex="-1" style="margin-top: 80px;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Подтверждение удаления</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <i class="fa fa-trash text-danger mb-4" style="font-size:48px;"></i>
                <p class="fs-5">Вы действительно хотите удалить категорию?</p>
                <p class="text-muted small">Это действие нельзя отменить.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="cancel-btn" data-bs-dismiss="modal">Отмена</button>
                <form id="deleteCategoryForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="save-btn">Удалить</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleCategory(id) {
            const collapseEl = document.getElementById('category-' + id);
            const bsCollapse = new bootstrap.Collapse(collapseEl, { toggle: true });
            const arrow = document.querySelector(`#category-${id}`).parentElement.querySelector('.category-arrow i');
            if (arrow) {
                arrow.classList.toggle('fa-chevron-down', !collapseEl.classList.contains('show'));
                arrow.classList.toggle('fa-chevron-up', collapseEl.classList.contains('show'));
            }
        }

        function showDeleteCategory(id) {
            const form = document.getElementById("deleteCategoryForm");
            form.action = "/Admin/Categories/Delete/" + id;
            const modal = new bootstrap.Modal(document.getElementById("deleteCategoryModal"));
            modal.show();
        }

        // ==================== ФИЛЬТРЫ И СОРТИРОВКА ====================
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const productsFilter = document.getElementById('productsFilter');
            const sortSelect = document.getElementById('sortSelect');
            const categoryCards = document.querySelectorAll('.product-form-card');

            function filterAndSort() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                const productFilterValue = productsFilter.value;
                const sortValue = sortSelect.value;

                const cardsArray = Array.from(categoryCards);

                cardsArray.forEach(card => {
                    const titleEl = card.querySelector('strong');
                    const name = titleEl ? titleEl.textContent.toLowerCase() : '';
                    const productsCountText = card.querySelector('.text-end strong') ||
                                            card.querySelector('.list-group-item strong:last-child');
                    const productsCount = productsCountText ? parseInt(productsCountText.textContent) || 0 : 0;

                    let visible = true;

                    // Поиск по названию
                    if (searchTerm && !name.includes(searchTerm)) visible = false;

                    // Фильтр по наличию товаров
                    if (productFilterValue === 'has' && productsCount === 0) visible = false;
                    if (productFilterValue === 'empty' && productsCount > 0) visible = false;

                    card.style.display = visible ? '' : 'none';
                });

                // Сортировка
                const visibleCards = cardsArray.filter(card => card.style.display !== 'none');

                visibleCards.sort((a, b) => {
                    const nameA = a.querySelector('strong').textContent.trim();
                    const nameB = b.querySelector('strong').textContent.trim();

                    const countA = parseInt(a.querySelector('.text-end strong')?.textContent) || 0;
                    const countB = parseInt(b.querySelector('.text-end strong')?.textContent) || 0;

                    if (sortValue === 'name-asc') return nameA.localeCompare(nameB);
                    if (sortValue === 'name-desc') return nameB.localeCompare(nameA);
                    if (sortValue === 'products-desc') return countB - countA;
                    if (sortValue === 'products-asc') return countA - countB;
                    return 0;
                });

                // Перемещаем карточки в новом порядке
                const parent = categoryCards[0].parentElement;
                visibleCards.forEach(card => parent.appendChild(card));
            }

            // События
            searchInput.addEventListener('input', filterAndSort);
            productsFilter.addEventListener('change', filterAndSort);
            sortSelect.addEventListener('change', filterAndSort);
        });

        // Существующий код защиты от кликов
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.action-area a, .action-area button').forEach(el => {
                el.addEventListener('click', function (e) {
                    e.stopImmediatePropagation();
                });
            });
        });
    </script>
}

<style>
    .admin-topbar { display: flex; justify-content: space-between; align-items: center; }
    .admin-header { font-size: 2.2rem; font-weight: 700; color: #222; margin-bottom: 4px; }
    .admin-subtitle { color: #666; margin: 0; font-size: 1.05rem; }

    .product-form-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .admin-icon-small {
        width: 48px; height: 48px;
        background: #ffbbb7;
        color: #222;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .category-header:hover { background: #fff0f5; }

    .category-arrow {
        font-size: 1.3rem;
        transition: transform 0.3s;
        cursor: pointer;
    }

    /* Кнопки */
    .btn-edit {
        background: #f8f9fa;
        color: #222;
        border: 2px solid #e6e6e6;
        border-radius: 12px;
        padding: 6px 18px;
        font-weight: 600;
        text-decoration: none !important;
    }
    .btn-edit:hover {
        background: #fff0f5;
        border-color: #ffbbb7;
        transform: translateY(-1px);
    }

    .btn-delete {
        background: #ffebee;
        color: #d32f2f;
        border: 2px solid #ffcdd2;
        border-radius: 12px;
        padding: 6px 18px;
        font-weight: 600;
    }
    .btn-delete:hover {
        background: #ffcdd2;
        color: #c62828;
        transform: translateY(-1px);
    }

    .save-btn {
        background: #ffbbb7;
        border: none;
        color: #222;
        height: 48px;
        padding: 0 24px;
        border-radius: 14px;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(255,187,183,.35);
        transition: .25s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .save-btn:hover {
            background: #ffaea9;
            transform: translateY(-2px);
        }

    .cancel-btn {
        height: 48px;
        padding: 0 24px;
        border-radius: 14px;
        font-weight: 600;
        color: #666;
        border: 2px solid #e6e6e6;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .cancel-btn:hover {
            background: #f8f9fa;
            color: #333;
        }

    .list-group-item {
        border: none;
        border-top: 1px solid #f1f1f1;
    }
    /* Фильтры (те же, что и на странице товаров) */
    .filters-panel {
        background: white;
        border-radius: 20px;
        padding: 20px 24px;
        margin-bottom: 24px;
        box-shadow: 0 4px 16px rgba(0,0,0,.06);
        display: flex;
        align-items: end;
        gap: 16px;
        flex-wrap: wrap;
    }

    .search-box {
        flex: 1;
        min-width: 280px;
    }

        .search-box input {
            width: 100%;
            padding: 14px 20px; /* одинаковый отступ со всех сторон */
            border: 2px solid #f1f1f1;
            border-radius: 16px;
            font-size: 16px;
            transition: all .25s;
        }

            .search-box input:focus {
                outline: none;
                border-color: #ffbbb7;
                box-shadow: 0 0 0 4px rgba(255,187,183,.15);
            }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .filter-group label {
            font-size: 13px;
            font-weight: 600;
            color: #666;
            margin-left: 4px;
        }

        .filter-group select {
            padding: 12px 16px;
            border: 2px solid #f1f1f1;
            border-radius: 14px;
            font-size: 15px;
            min-width: 170px;
            background: white;
        }

            .filter-group select:focus {
                outline: none;
                border-color: #ffbbb7;
            }
</style>