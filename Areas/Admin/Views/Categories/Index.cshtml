@model IEnumerable<FlowerShop.Models.Category>

@{
    ViewData["Title"] = "Категории";

    var rootCategories = Model
        .Where(x => x.ParentCategoryId == null)
        .OrderBy(x => x.Id)
        .ToList();
}

<div class="container mt-4">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1>Категории</h1>

        <a asp-action="Create"
           class="btn btn-primary">
            Добавить категорию
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            Категории отсутствуют
        </div>
    }
    else
    {
        @foreach (var root in rootCategories)
        {
            <div class="card shadow-sm mb-3">
                @{
                    var totalProducts =
                    root.Products.Count +
                    Model.Where(x => x.ParentCategoryId == root.Id)
                    .Sum(x => x.Products.Count);
                }
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center category-toggle"
                     data-bs-toggle="collapse"
                     data-bs-target="#category-@root.Id"
                     style="cursor:pointer;">

                    <div>
                        <strong>@root.Name</strong>

                        <span class="badge bg-light text-dark ms-2">
                            ID: @root.Id
                        </span>

                        <span class="badge bg-primary ms-2">
                            Всего товаров: @totalProducts
                        </span>

                        <span class="badge bg-success ms-2">
                            В категории: @root.Products.Count
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-2">

                        <div class="d-flex gap-2">

                            <a asp-action="Edit"
                               asp-route-id="@root.Id"
                               class="btn btn-light btn-sm"
                               onclick="event.stopPropagation();">
                                Изменить
                            </a>

                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    onclick="showDeleteCategory(@root.Id)">
                                Удалить
                            </button>

                        </div>

                        <span class="category-arrow ms-2">
                            <i class="fa fa-chevron-down"></i>
                        </span>

                    </div>

                </div>


                <div id="category-@root.Id" class="collapse">

                    <div class="card-body">

                        @{
                            var children = Model
                            .Where(x => x.ParentCategoryId == root.Id)
                            .OrderBy(x => x.Id)
                            .ToList();
                        }

                        @if (children.Any())
                        {
                            <ul class="list-group">

                            @foreach (var child in children)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">

                                    <div>
                                        @child.Name

                                        <span class="badge bg-secondary ms-2">
                                            ID: @child.Id
                                        </span>

                                        <span class="badge bg-success ms-2">
                                            Товаров: @child.Products.Count
                                        </span>
                                    </div>

                                        <div class="d-flex gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@child.Id"
                                               class="btn btn-warning btn-sm">
                                                Изменить
                                            </a>

                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="showDeleteCategory(@child.Id)">
                                                Удалить
                                            </button>

                                        </div>

                                </li>
                            }

                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">
                            Нет подкатегорий
                        </span>
                    }

                    </div>
                </div>
            </div>
        }
    }
    <!-- Модальное подтверждение удаления -->
    <div class="modal fade"
         id="deleteCategoryModal"
         tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Подтверждение удаления
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body text-center">

                    <i class="fa fa-trash text-danger mb-3"
                       style="font-size:42px;">
                    </i>

                    <p class="fs-5">
                        Вы действительно хотите удалить категорию?
                    </p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Отмена
                    </button>

                    <form id="deleteCategoryForm"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger">
                            Удалить
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
</div>

<style>
    .category-arrow {
        display: inline-block;
        transition: transform 0.25s ease;
    }

        .category-arrow.rotate {
            transform: rotate(180deg);
        }
</style>
<script>
    document.addEventListener('DOMContentLoaded', function () {

        document.querySelectorAll('.category-toggle').forEach(header => {

            header.addEventListener('click', function () {

                const arrow =
                    this.querySelector('.category-arrow');

                arrow.classList.toggle('rotate');

            });

        });

    });
</script>

<script>

    function showDeleteCategory(id)
    {
        const form =
            document.getElementById(
                "deleteCategoryForm"
            );

        form.action =
            "/Admin/Categories/Delete/" + id;

        const modal =
            new bootstrap.Modal(
                document.getElementById(
                    "deleteCategoryModal"
                )
            );

        modal.show();
    }

</script>