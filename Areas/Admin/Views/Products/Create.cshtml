@model FlowerShop.Models.Product
@{
    ViewData["Title"] = "Добавить товар";
}

<div class="container mt-4">
    <div class="admin-topbar mb-4">
        <div>
            <h1 class="admin-header">
                Добавление товара
            </h1>
            <p class="admin-subtitle">
                Создание нового товара в магазине PetalStory
            </p>
        </div>
    </div>

    <form asp-action="Create"
          method="post"
          enctype="multipart/form-data">
        <div class="product-form-card">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label class="form-label">Название</label>
                        <input asp-for="Name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Описание</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="8"></textarea>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Цена</label>
                            <input asp-for="Price"
                                   type="number"
                                   class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Скидка (%)</label>
                            <input asp-for="DiscountPercentage"
                                   type="number"
                                   class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Количество</label>
                            <input asp-for="StockQuantity"
                                   type="number"
                                   class="form-control" />
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">
                                Категория
                            </label>
                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.Categories"
                                    class="form-select">
                                <option value="0">
                                    Выберите категорию
                                </option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">
                                Статус
                            </label>
                            <div class="active-box">
                                <input asp-for="IsActive"
                                       type="checkbox"
                                       class="form-check-input me-2" />
                                <span>Активен</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <label class="form-label">
                        Фото товара
                    </label>
                    <input asp-for="ImageFile"
                           type="file"
                           id="imageInput"
                           accept=".jpg,.jpeg,.png,.webp"
                           style="display:none"
                           onchange="previewImage(event)" />
                    <div class="image-upload-container">
                        <img id="imagePreview"
                             src="/images/no-image.jpg"
                             onclick="document.getElementById('imageInput').click()"
                             class="image-preview" />
                        <button type="button"
                                id="removeImageBtn"
                                class="remove-image-btn"
                                onclick="removeImage()">
                            ✕
                        </button>
                    </div>
                </div>
            </div>

            <div class="form-footer">
                <button type="submit"
                        class="save-btn">
                    Сохранить товар
                </button>
                <a asp-action="Index"
                   class="cancel-btn">
                    Отмена
                </a>
            </div>
        </div>
    </form>
</div>

<script>
    function previewImage(event)
    {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function ()
        {
            const preview = document.getElementById("imagePreview");
            preview.src = reader.result;
            preview.classList.add("has-image");
            document.getElementById("removeImageBtn").style.display = "flex";
        };
        reader.readAsDataURL(file);
    }

    function removeImage()
    {
        document.getElementById("imageInput").value = "";
        const preview = document.getElementById("imagePreview");
        preview.src = "/images/no-image.jpg";
        preview.classList.remove("has-image");
        document.getElementById("removeImageBtn").style.display = "none";
    }
</script>

<style>
    .image-upload-container {
        position: relative;
        width: 100%;
        max-width: 320px;
    }

    .image-preview {
        width: 100%;
        height: 320px;
        object-fit: cover;
        border: 2px dashed #d9d9d9;
        border-radius: 20px;
        background: #fafafa;
        cursor: pointer;
        transition: 0.2s;
        display: block;
    }

        .image-preview.has-image {
            border: none;
        }

    .remove-image-btn {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 35px;
        height: 35px;
        border: none;
        border-radius: 50%;
        background: #dc3545;
        color: white;
        font-size: 18px;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
    }

        .remove-image-btn:hover {
            background: #bb2d3b;
        }

    .product-form-card {
        background: white;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
        margin-bottom: 25px;
    }

    .save-btn {
        background: #ffbbb7;
        border: none;
        color: #222;
        height: 54px;
        padding: 0 30px;
        border-radius: 14px;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(255,187,183,.35);
        transition: .25s;
    }

        .save-btn:hover {
            background: #ffaea9;
            transform: translateY(-2px);
        }

    .cancel-btn {
        height: 54px;
        padding: 0 30px;
        border-radius: 14px;
        font-weight: 600;
        color: #666;
        border: 2px solid #e6e6e6;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        margin-left: 12px;
        transition: .25s;
    }

        .cancel-btn:hover {
            background: #f8f9fa;
            color: #333;
        }

    .active-box {
        height: 52px;
        border-radius: 14px;
        background: #fff0f5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }

    .form-control,
    .form-select {
        border-radius: 14px;
        height: 52px;
        border: 1px solid #e6e6e6;
    }

    textarea.form-control {
        height: auto;
        resize: none;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-footer {
        margin-top: 35px;
        padding-top: 25px;
        border-top: 1px solid #f1f1f1;
    }

    .admin-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .admin-header {
        font-size: 2.2rem;
        font-weight: 700;
        color: #222;
        margin-bottom: 4px;
    }

    .admin-subtitle {
        color: #666;
        margin: 0;
        font-size: 1.05rem;
    }
</style>