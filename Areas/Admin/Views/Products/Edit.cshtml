@model FlowerShop.Models.Product

@{
    ViewData["Title"] = "Редактирование товара";
}

<div class="container mt-4">

    <h1>Редактирование товара</h1>

    <form asp-action="Edit" method="post">

        <input asp-for="Id" type="hidden" />

        <div class="mb-3">
            <label class="form-label">Название</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Описание</label>
            <textarea asp-for="Description"
             class="form-control"
             rows="6"
             style="resize:none;"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Цена</label>
            <input asp-for="Price"
                   type="number"
                   min="1"
                   step="1"
                   class="form-control" />
            <span asp-validation-for="Price"
                  class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Скидка (%)</label>

            <input asp-for="DiscountPercentage"
                   type="number"
                   min="0"
                   max="100"
                   step="1"
                   class="form-control" />

            <span asp-validation-for="DiscountPercentage"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Количество</label>
            <input asp-for="StockQuantity"
                   type="number"
                   min="0"
                   step="1"
                   class="form-control" />
            <span asp-validation-for="StockQuantity"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Категория</label>

            <select asp-for="CategoryId"
                    asp-items="ViewBag.Categories"
                    class="form-select">
            </select>
        </div>

        <div class="form-check mb-3">

            <input asp-for="IsActive"
                   class="form-check-input" />

            <label class="form-check-label">
                Активен
            </label>

        </div>

        <button type="submit"
                class="btn btn-success">
            Сохранить изменения
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Отмена
        </a>

    </form>

</div>