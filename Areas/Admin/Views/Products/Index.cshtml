@model IEnumerable<FlowerShop.Models.Product>

@{
    ViewData["Title"] = "Товары";
}

<div class="container mt-4">

    <div class="admin-topbar">

        <div>
            <h1 class="admin-header">
                Товары
            </h1>

            <p class="admin-subtitle">
                Управление ассортиментом магазина
            </p>
        </div>

        <a asp-action="Create"
           class="add-btn">
            + Добавить товар
        </a>

    </div>

    <div class="products-table-wrapper">

        <table class="products-table">

        <thead>
            <tr>
                <th>ID</th>
                <th>Фото</th>
                <th>Название</th>
                <th>Цена</th>
                <th>Остаток</th>
                <th>Категория</th>
                <th>Активен</th>
                <th>Действия</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Id</td>
                    <td>

                            <img src="@(string.IsNullOrEmpty(item.Picture)
                                      ? "/images/no-image.jpg"
                                      : item.Picture)"
                             class="product-thumb" />

                    </td>
                    <td>@item.Name</td>

                        <td class="price-cell">
                            @item.Price?.ToString("N2") ₽
                        </td>

                    <td>@item.StockQuantity</td>

                    <td>@item.Category?.Name</td>

                    <td>
                        @(item.IsActive == true ? "Да" : "Нет")
                    </td>
                        <td class="actions-cell">

                            <div class="actions-wrapper">

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="action-btn edit-btn">
                                    Изменить
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="action-btn delete-btn"
                                            onclick="return confirm('Удалить товар?')">
                                        Удалить
                                    </button>

                                </form>

                            </div>

                        </td>

                </tr>
            }

        </tbody>

    </table>
    </div>
</div>
<style>
    .price-cell {
        min-width: 140px;
        white-space: nowrap;
        font-weight: 600;
        color: #72D572;
    }

    .actions-cell {
        min-width: 220px;
    }

    .actions-wrapper {
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .actions-wrapper form {
            margin: 0;
        }

    .action-btn {
        white-space: nowrap;
    }
    .admin-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .admin-header {
        font-size: 42px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .admin-subtitle {
        color: #888;
        font-size: 18px;
    }

    .add-btn {
        background: #ffbbb7;
        color: #222;
        text-decoration: none;
        padding: 14px 24px;
        border-radius: 14px;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(255,187,183,.35);
        transition: .25s;
    }

        .add-btn:hover {
            background: #ffaea9;
            color: #222;
            transform: translateY(-2px);
        }

    .products-table-wrapper {
        background: white;
        border-radius: 24px;
        padding: 20px;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }

    .products-table {
        width: 100%;
        border-collapse: collapse;
    }

        .products-table thead {
            background: #fff0f5;
        }

        .products-table th {
            padding: 16px;
            font-weight: 700;
            color: #222;
        }

        .products-table td {
            padding: 16px;
            border-top: 1px solid #f1f1f1;
            vertical-align: middle;
        }

        .products-table tbody tr {
            transition: .2s;
        }

            .products-table tbody tr:hover {
                background: #fff8f8;
            }

    .product-thumb {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 14px;
        border: 1px solid #eee;
    }

    .action-btn {
        border: none;
        padding: 8px 14px;
        border-radius: 10px;
        text-decoration: none;
        color: #222;
        font-weight: 600;
        transition: .25s;
    }

    .edit-btn {
        background: #ffe4ec;
    }

        .edit-btn:hover {
            background: #ffd4df;
        }

    .delete-btn {
        background: #ffd7d7;
    }

        .delete-btn:hover {
            background: #ffc3c3;
        }

</style>