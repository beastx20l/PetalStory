@model IEnumerable<FlowerShop.Models.Order>
@{
    ViewData["Title"] = "Заказы";
}

<div class="container mt-4">
    <div class="admin-topbar">
        <div>
            <h1 class="admin-header">
                Заказы
            </h1>
            <p class="admin-subtitle">
                Управление заказами магазина PetalStory
            </p>
        </div>
    </div>
    <!-- === ФИЛЬТРЫ И ПОИСК ЗАКАЗОВ === -->
    <div class="filters-panel">
        <div class="search-box">
            <input type="text" id="searchInput" placeholder="Поиск по клиенту или номеру заказа" autocomplete="off">
        </div>

        <div class="filter-group">
            <label>Статус</label>
            <select id="statusFilter">
                <option value="">Все статусы</option>
                <option value="новый">Новый</option>
                <option value="в обработке">В обработке</option>
                <option value="доставлен">Доставлен</option>
            </select>
        </div>

        <div class="filter-group">
            <label>Сортировка</label>
            <select id="sortSelect">
                <option value="date-desc">Дата (сначала новые)</option>
                <option value="date-asc">Дата (сначала старые)</option>
                <option value="amount-desc">Сумма (по убыванию)</option>
                <option value="amount-asc">Сумма (по возрастанию)</option>
            </select>
        </div>
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="products-table-wrapper">
        <table class="products-table">
            <thead>
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th style="width: 150px;">Дата</th>
                    <th>Клиент</th>
                    <th style="width: 130px;">Телефон</th>
                    <th class="text-end" style="width: 110px;">Сумма</th>
                    <th style="width: 160px;">Статус</th>
                    <th class="text-center" style="width: 70px;">Товаров</th>
                    <th class="text-end" style="width: 120px;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.OrderByDescending(o => o.CreatedAt))
                {
                    <tr>
                        <td><strong>#@order.Id</strong></td>
                        <td>@order.CreatedAt.ToString("dd.MM.yyyy")<br><small>@order.CreatedAt.ToString("HH:mm")</small></td>
                        <td>@order.CustomerName</td>
                        <td>@order.Phone</td>
                        <td class="text-end price-cell"><strong>@order.TotalAmount.ToString("N0") ₽</strong></td>
                        <td>
                            <span class="status-badge @GetStatusCssClass(order.Status)">
                                @order.Status
                            </span>
                        </td>
                        <td class="text-center">@order.OrderItems.Count</td>
                        <td class="actions-cell">
                            <a asp-action="Details" asp-route-id="@order.Id" class="action-btn edit-btn">
                                Подробнее
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .admin-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .admin-header {
        font-size: 42px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .admin-subtitle {
        color: #888;
        font-size: 18px;
    }

    .products-table-wrapper {
        background: white;
        border-radius: 24px;
        padding: 20px;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }

    .products-table {
        width: 100%;
        border-collapse: collapse;
    }

        .products-table thead {
            background: #fff0f5;
        }

        .products-table th {
            padding: 16px 8px;
            font-weight: 700;
            color: #222;
        }

        .products-table td {
            padding: 16px 8px;
            border-top: 1px solid #f1f1f1;
            vertical-align: middle;
        }

        .products-table tbody tr:hover {
            background: #fff8f8;
        }

    .price-cell {
        font-weight: 600;
        color: #72D572;
    }

    .actions-cell {
        min-width: 120px;
    }

    .action-btn {
        padding: 8px 16px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        background: #ffe4ec;
        color: #222;
        display: inline-block;
        transition: .25s;
    }

        .action-btn:hover {
            background: #ffd4df;
            transform: translateY(-1px);
        }

    /* Статусы */
    .status-badge {
        padding: 7px 14px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.93rem;
        display: inline-block;
        min-width: 110px;
        text-align: center;
    }

    .status-new {
        background: #fff3cd;
        color: #856404;
    }

    .status-в обработке {
        background: #cce5ff;
        color: #004085;
    }

    .status-доставлен {
        background: #d4edda;
        color: #155724;
    }

    .status-processing {
        background: #dbeafe;
        color: #2563eb;
    }

    .status-delivered {
        background: #d4edda;
        color: #155724;
    
    }
    /* Фильтры */
    .filters-panel {
        background: white;
        border-radius: 20px;
        padding: 20px 24px;
        margin-bottom: 24px;
        box-shadow: 0 4px 16px rgba(0,0,0,.06);
        display: flex;
        align-items: end;
        gap: 16px;
        flex-wrap: wrap;
    }

    .search-box {
        flex: 1;
        min-width: 280px;
    }

        .search-box input {
            width: 100%;
            padding: 14px 20px;
            border: 2px solid #f1f1f1;
            border-radius: 16px;
            font-size: 16px;
            transition: all .25s;
        }

            .search-box input:focus {
                outline: none;
                border-color: #ffbbb7;
                box-shadow: 0 0 0 4px rgba(255,187,183,.15);
            }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .filter-group label {
            font-size: 13px;
            font-weight: 600;
            color: #666;
            margin-left: 4px;
        }

        .filter-group select {
            padding: 12px 16px;
            border: 2px solid #f1f1f1;
            border-radius: 14px;
            font-size: 15px;
            min-width: 170px;
            background: white;
        }

            .filter-group select:focus {
                outline: none;
                border-color: #ffbbb7;
            }
</style>

@functions {
    private string GetStatusCssClass(string status)
    {
        return status?.ToLower() switch
        {
            "новый" => "status-new",
            "в обработке" => "status-processing",
            "доставлен" => "status-delivered",
            _ => "status-new"
        };
    }
}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('searchInput');
        const statusFilter = document.getElementById('statusFilter');
        const sortSelect = document.getElementById('sortSelect');
        const tbody = document.querySelector('.products-table tbody');

        function filterAndSort() {
            const searchTerm = searchInput.value.toLowerCase().trim();
            const selectedStatus = statusFilter.value.toLowerCase();
            const sortValue = sortSelect.value;

            const rows = Array.from(tbody.querySelectorAll('tr'));

            rows.forEach(row => {
                const orderId = row.cells[0].textContent.toLowerCase();
                const clientName = row.cells[2].textContent.toLowerCase();
                const statusText = row.cells[5].textContent.trim().toLowerCase();

                let visible = true;

                // Поиск
                if (searchTerm && !orderId.includes(searchTerm) && !clientName.includes(searchTerm)) {
                    visible = false;
                }

                // Фильтр по статусу
                if (selectedStatus && statusText !== selectedStatus) {
                    visible = false;
                }

                row.style.display = visible ? '' : 'none';
            });

            // Сортировка
            const visibleRows = rows.filter(row => row.style.display !== 'none');

            visibleRows.sort((a, b) => {
                if (sortValue === 'date-desc' || sortValue === 'date-asc') {
                    // Сортировка по дате (используем первую ячейку с датой)
                    const dateA = a.cells[1].textContent.trim();
                    const dateB = b.cells[1].textContent.trim();
                    return sortValue === 'date-desc'
                        ? dateB.localeCompare(dateA)
                        : dateA.localeCompare(dateB);
                }
                else if (sortValue === 'amount-desc' || sortValue === 'amount-asc') {
                    const amountA = parseFloat(a.cells[4].textContent.replace(/[^0-9]/g, '')) || 0;
                    const amountB = parseFloat(b.cells[4].textContent.replace(/[^0-9]/g, '')) || 0;
                    return sortValue === 'amount-desc' ? amountB - amountA : amountA - amountB;
                }
                return 0;
            });

            visibleRows.forEach(row => tbody.appendChild(row));
        }

        searchInput.addEventListener('input', filterAndSort);
        statusFilter.addEventListener('change', filterAndSort);
        sortSelect.addEventListener('change', filterAndSort);
    });
</script>