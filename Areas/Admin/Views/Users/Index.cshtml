@model List<FlowerShop.Models.User>

@{
    ViewData["Title"] = "Пользователи";
}

<div class="container mt-4">

    <div class="admin-topbar">
        <div>
            <h1 class="admin-header">
                Пользователи
            </h1>

            <p class="admin-subtitle">
                Управление аккаунтами магазина PetalStory
            </p>
        </div>
    </div>

    <div class="products-table-wrapper">

        <table class="products-table">

            <thead>
                <tr>
                    <th style="width:70px;">ID</th>
                    <th>Пользователь</th>
                    <th>Email</th>
                    <th>Телефон</th>
                    <th style="width:150px;">Регистрация</th>
                    <th style="width:140px;">Статус</th>
                    <th style="width:140px;">Действие</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var user in Model)
                {
                    <tr>

                        <td>
                            <strong>#@user.Id</strong>
                        </td>

                        <td>
                            @user.FirstName @user.LastName
                        </td>

                        <td>
                            @user.Email
                        </td>

                        <td>
                            @user.Phone
                        </td>

                        <td>
                            @user.CreatedAt.ToString("dd.MM.yyyy")
                        </td>

                        <td>

                            @if (user.IsActive)
                            {
                                <span class="status-badge status-active">
                                    Активен
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-banned">
                                    Заблокирован
                                </span>
                            }

                        </td>

                        <td class="actions-cell d-flex flex-column gap-2">

                            <a asp-action="Details"
                               asp-route-id="@user.Id"
                               class="action-btn edit-btn">
                                Подробнее
                            </a>

                            <form asp-action="ToggleBan"
                                  method="post"
                                  class="w-100">

                                <input type="hidden"
                                       name="id"
                                       value="@user.Id" />

                                @if (user.IsActive)
                                {
                                    <button class="action-btn delete-btn">
                                        Забанить
                                    </button>
                                }
                                else
                                {
                                    <button class="action-btn restore-btn">
                                        Разбанить
                                    </button>
                                }

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<style>

    .admin-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .admin-header {
        font-size: 42px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .admin-subtitle {
        color: #888;
        font-size: 18px;
    }

    .products-table-wrapper {
        background: white;
        border-radius: 24px;
        padding: 20px;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }

    .products-table {
        width: 100%;
        border-collapse: collapse;
    }

        .products-table thead {
            background: #fff0f5;
        }

        .products-table th {
            padding: 16px 8px;
            font-weight: 700;
            color: #222;
        }

        .products-table td {
            padding: 16px 8px;
            border-top: 1px solid #f1f1f1;
            vertical-align: middle;
        }

        .products-table tbody tr:hover {
            background: #fff8f8;
        }

    .status-badge {
        padding: 7px 14px;
        border-radius: 12px;
        font-weight: 600;
        font-size: .93rem;
        display: inline-block;
        min-width: 110px;
        text-align: center;
    }

    .status-active {
        background: #d4edda;
        color: #155724;
    }

    .status-banned {
        background: #f8d7da;
        color: #721c24;
    }

    .action-btn {
        border: none;
        padding: 8px 14px;
        border-radius: 10px;
        font-weight: 600;
        transition: .25s;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
        width: 100%;
        text-align: center;
    }

    .edit-btn {
        background: #f1f3f5;
        color: #333;
    }

        .edit-btn:hover {
            background: #e2e6ea;
            color: #222;
            transform: translateY(-1px);
            text-decoration: none;
        }
    .ban-btn {
        background: #ffe4ec;
        color: #222;
    }

        .ban-btn:hover {
            background: #ffd4df;
            transform: translateY(-1px);
        }

    .unban-btn {
        background: #dff5df;
        color: #155724;
    }

        .unban-btn:hover {
            background: #c8efc8;
            transform: translateY(-1px);
        }

    .delete-btn {
        background: #f8d7da;
        color: #721c24;
    }

        .delete-btn:hover {
            background: #f1bfc4;
            color: #721c24;
            transform: translateY(-1px);
        }

    .restore-btn {
        background: #d4edda;
        color: #155724;
    }

        .restore-btn:hover {
            background: #c3e6cb;
            color: #155724;
            transform: translateY(-1px);
        }
</style>