@model dynamic
@{
    ViewData["Title"] = "Админ-панель";
}

<div class="container mt-4">
    <h1 class="admin-header">
        Админ-панель
    </h1>
    <p class="admin-subtitle">
        Управление магазином PetalStory
    </p>
    

    <!-- Основные карточки -->
    <div class="row mt-4 g-4">
        <div class="col-md-6 col-lg-3">
            <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="admin-card">
                <div class="admin-icon">
                    <i class="fa fa-box"></i>
                </div>
                <div class="admin-title">Товары</div>
                <div class="admin-desc">Управление ассортиментом магазина</div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="admin-card">
                <div class="admin-icon">
                    <i class="fa fa-tags"></i>
                </div>
                <div class="admin-title">Категории товаров</div>
                <div class="admin-desc">Настройка структуры каталога</div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="admin-card">
                <div class="admin-icon">
                    <i class="fa fa-clipboard-list"></i>
                </div>
                <div class="admin-title">Заказы</div>
                <div class="admin-desc">Просмотр и обработка заказов</div>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="admin-card">
                <div class="admin-icon">
                    <i class="fa fa-users"></i>
                </div>
                <div class="admin-title">Пользователи</div>
                <div class="admin-desc">Управление клиентами магазина</div>
            </a>
        </div>
    </div>

    <!-- === СТАТИСТИКА === -->
    <div class="mt-5">
        <h2 class="section-title">Статистика магазина</h2>
        <p class="admin-subtitle mb-4">Ключевые показатели за текущий период</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="admin-card stat-card">
                <div class="admin-icon">
                    <i class="fa fa-shopping-bag"></i>
                </div>
                <div class="admin-title">@Model.TotalOrders</div>
                <div class="admin-desc">Всего заказов</div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="admin-card stat-card">
                <div class="admin-icon">
                    <i class="fa fa-users"></i>
                </div>
                <div class="admin-title">@Model.TotalUsers</div>
                <div class="admin-desc">Пользователей</div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="admin-card stat-card">
                <div class="admin-icon">
                    <i class="fa fa-ruble-sign"></i>
                </div>
                <div class="admin-title">@Model.MonthlyRevenue.ToString("N0") ₽</div>
                <div class="admin-desc">Выручка за месяц</div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="admin-card stat-card">
                <div class="admin-icon">
                    <i class="fa fa-calendar-day"></i>
                </div>
                <div class="admin-title">@Model.DailyRevenue.ToString("N0") ₽</div>
                <div class="admin-desc">Выручка за сегодня</div>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-card {
        display: block;
        background: white;
        border-radius: 24px;
        padding: 30px 20px;
        text-align: center;
        text-decoration: none;
        color: #222;
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
        transition: .25s;
        height: 100%;
    }

        .admin-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 28px rgba(255,187,183,.35);
            color: #222;
        }

    .stat-card {
        cursor: default;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 28px rgba(25, 118, 210, .25);
        }

    .admin-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #ffbbb7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        color: #222;
    }

    .stat-card .admin-icon {
        background: #e3f2fd;
        color: #1976d2;
    }

    .admin-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
        color: #222;
    }

    .admin-desc {
        font-size: 14px;
        color: #888;
        line-height: 1.4;
    }

    .admin-header {
        font-size: 42px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .admin-subtitle {
        color: #888;
        font-size: 18px;
        margin-bottom: 30px;
    }

    /* Новый стиль для подзаголовка статистики */
    .section-title {
        font-size: 32px;
        font-weight: 700;
        color: #222;
        margin-bottom: 8px;
    }
</style>